msgstr "Syli Atlas importa cada nueva edición, la verifica y luego la publica. Los gráficos muestran las estimaciones y proyecciones en línea discontinua."

#: lib/syli_atlas_web/controllers/glossary_controller.ex:220
#, elixir-autogen, elixir-format
msgid "The IMF and World Bank assessment, for low-income countries, of the risk that a state cannot service its external debt."
msgstr "La evaluación del FMI y del Banco Mundial, para los países de ingreso bajo, del riesgo de que un Estado no pueda atender su deuda externa."

#: lib/syli_atlas_web/controllers/country_questions_controller.ex:343
#, elixir-autogen, elixir-format
msgid "The IMF and the World Bank consider %{name} in debt distress (analysis of %{date}): it struggles to pay its creditors."
msgstr "El FMI y el Banco Mundial consideran que %{name} está en sobreendeudamiento (análisis del %{date}): le cuesta pagar a sus acreedores."

#: lib/syli_atlas_web/controllers/country_questions_controller.ex:186
#, elixir-autogen, elixir-format
msgid "The IMF projects %{growth} for %{year}."
msgstr "El FMI proyecta un %{growth} para %{year}."

