# Variables read at boot by config/runtime.exs. Copy to .env for local use
# (never commit .env). On Railway, set them on the `syliatlas` service.

# --- Site address and search engines --------------------------------------
# The public host: canonical URLs, sitemap, passkeys (rp_id). Production:
# syliatlas.com; development: dev.syliatlas.com. Changing it makes existing
# passkeys unusable (members sign in with a code and add a new one).
# PHX_HOST=syliatlas.com

# Requests on any other host (*.up.railway.app, www.) get a 301 to PHX_HOST.
# On by default, off when PHX_HOST is itself a *.up.railway.app address.
# CANONICAL_REDIRECT=true

# true on every copy that must stay out of search engines (development):
# X-Robots-Tag: noindex on every response, robots.txt disallows everything.
# SITE_NOINDEX=true

# Where to report an accessibility barrier, shown on the accessibility
# statement (/fr/accessibilite).
# CONTACT_EMAIL=accessibilite@example.com

# --- Emails ------------------------------------------------------------------
# One of resend | smtp | local. Without it: resend if RESEND_API_KEY is set,
# else smtp if SMTP_HOST is set, else local in development and nothing in a
# release (sign-in by email then says it is not open yet).
# MAILER_ADAPTER=

# Production: Resend (https://resend.com), with a verified sending domain.
# RESEND_API_KEY=re_...

# Outside production: Mailpit. On Railway, its private host; locally,
# `docker compose up -d mailpit` then http://localhost:8025 to read them.
# SMTP_HOST=mailpit.railway.internal
# SMTP_PORT=1025
# SMTP_USERNAME=        # only if the SMTP server asks (Mailpit does not)
# SMTP_PASSWORD=
# SMTP_TLS=never        # never | if_available | always

# Sender, an address of the verified domain in production.
# MAIL_FROM=Syli Atlas <bonjour@example.com>

# The only address allowed to become the first administrator. Set it
# before the first deploy with accounts: otherwise the first person to sign
# up after the deploy becomes the administrator.
# FIRST_ADMIN_EMAIL=you@example.com

# --- Market data ---------------------------------------------------------------
# The MansaAPI key (100 calls a day for every environment together).
# STOCK_EXCHANGE_API_KEY=
# Development: fictitious figures from SyliAtlas.Market.Sources.MansaFake, no
# call to mansaapi.com, no quota spent, pages say the figures are fictitious.
# Refused in the Railway environment named "production".
# MANSA_FAKE=true

# --- Public API ----------------------------------------------------------------
# Cloudflare: after each publication of data, the API answers are dropped
# from its cache (SyliAtlas.Cdn). A token with the single permission
# Zone > Cache Purge on the site's zone. Without them, no purge: the cache
# rule's one-day TTL still bounds how long old answers live.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# Requests per minute and per visitor address on the public API (60).
# RATE_LIMIT_PER_MINUTE=60
