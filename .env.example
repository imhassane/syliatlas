# Variables read at boot by config/runtime.exs. Copy to .env for local use
# (never commit .env). On Railway, set them on the `syliatlas` service.

# --- Emails ------------------------------------------------------------------
# One of resend | smtp | local. Without it: resend if RESEND_API_KEY is set,
# else smtp if SMTP_HOST is set, else local in development and nothing in a
# release (sign-in by email then says it is not open yet).
# MAILER_ADAPTER=

# Production: Resend (https://resend.com), with a verified sending domain.
# RESEND_API_KEY=re_...

# Outside production: Mailpit. On Railway, its private host; locally,
# `docker compose up -d mailpit` then http://localhost:8025 to read them.
# SMTP_HOST=mailpit.railway.internal
# SMTP_PORT=1025
# SMTP_USERNAME=        # only if the SMTP server asks (Mailpit does not)
# SMTP_PASSWORD=
# SMTP_TLS=never        # never | if_available | always

# Sender, an address of the verified domain in production.
# MAIL_FROM=Syli Atlas <bonjour@example.com>

# The only address allowed to become the first administrator. Set it
# before the first deploy with accounts: otherwise the first person to sign
# up after the deploy becomes the administrator.
# FIRST_ADMIN_EMAIL=you@example.com
