<!DOCTYPE html>
<html lang={assigns[:locale] || "fr"} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta :if={!assigns[:public]} name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Syli Atlas" suffix=" · Syli Atlas" phx-no-format>{assigns[:page_title]}</.live_title>
    <meta :if={assigns[:seo][:description]} name="description" content={@seo[:description]} />
    <link :if={assigns[:seo][:canonical]} rel="canonical" href={@seo[:canonical]} />
    <link
      :for={{lang, href} <- assigns[:seo][:alternates] || []}
      rel="alternate"
      hreflang={lang}
      href={href}
    />
    <meta :if={assigns[:seo][:noindex]} name="robots" content="noindex" />
    <meta property="og:site_name" content="Syli Atlas" />
    <meta :if={assigns[:page_title]} property="og:title" content={@page_title} />
    <meta
      :if={assigns[:seo][:description]}
      property="og:description"
      content={@seo[:description]}
    />
    <meta :if={assigns[:seo][:image]} property="og:image" content={@seo[:image]} />
    <meta name="twitter:card" content="summary_large_image" />
    <script :for={ld <- assigns[:seo][:json_ld] || []} type="application/ld+json">
      <%= Phoenix.HTML.raw(Jason.encode!(ld)) %>
    </script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="syli-version" content={SyliAtlasWeb.Build.version()} />
    <meta name="syli-build" content={SyliAtlasWeb.Build.id()} />
    <meta name="theme-color" content="#0b1a33" />
    <link rel="icon" href={~p"/images/icon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <script>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = t;
        } catch (e) {}
        document.documentElement.classList.add("js");
        // Entrance animations play once per page and session. A page prepared in
        // advance (speculation rules below) counts as seen only once shown.
        var markSeen = function () {
          try {
            var seen = JSON.parse(sessionStorage.getItem("seen") || "[]");
            if (seen.indexOf(location.pathname) >= 0) document.documentElement.classList.add("revisit");
            else sessionStorage.setItem("seen", JSON.stringify(seen.concat(location.pathname).slice(-50)));
          } catch (e) {}
        };
        if (document.prerendering) document.addEventListener("prerenderingchange", markSeen, {once: true});
        else markSeen();
        if (!navigator.onLine) document.documentElement.classList.add("is-offline");
      })();
    </script>
    <%!-- Page arrival. The browser does no transition between pages (it would
         freeze the band in a still image): the new page is shown at once and
         moves itself, live, before its first paint.
         - Most pages: the content rises 14 px.
         - A tab of a country profile: the tab bar stays where the reader left
           it (or stuck under the band), its underline slides from the old tab,
           the content comes in from the tab's side.
         - A filter or sort of a table: the table stays in place, each row
           slides from its old position, new rows rise.
         The old page writes where things were when its link was clicked
         (assets/js/ui/transitions.js). Nothing moves with reduced motion. --%>
    <script>
      (function () {
        var EASE = "cubic-bezier(.22, 1, .36, 1)";
        var arrive = function () {
          var saved = null;
          try { saved = JSON.parse(sessionStorage.getItem("arrival")); sessionStorage.removeItem("arrival"); } catch (x) {}
          if (saved && saved.to !== location.href) saved = null;
          var still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          var stickyTop = document.getElementById("site-ticker") ? document.getElementById("site-ticker").offsetHeight : 0;
          var move = function (el, from, ms) {
            if (!still && el && el.animate) el.animate([{transform: from}, {transform: "none"}], {duration: ms || 360, easing: EASE});
          };

          // Same place as on the old page, also when the link carried an anchor
          // (the anchor would scroll once more at the end of parsing).
          var keep = function (y) {
            if (location.hash) history.replaceState(history.state, "", location.pathname + location.search);
            scrollTo({top: y, behavior: "instant"});
            if (document.readyState === "loading")
              document.addEventListener("DOMContentLoaded", function () { scrollTo({top: y, behavior: "instant"}); }, {once: true});
          };

          if (saved && saved.kind === "tab") {
            var bar = document.querySelector(".tab-bar"), panel = document.querySelector(".tab-panel");
            if (bar && panel) {
              var natural = panel.getBoundingClientRect().top + scrollY - bar.offsetHeight;
              keep(natural - Math.max(saved.top, stickyTop));
              // Near the top of a page whose hero is shorter, the bar cannot stay:
              // it glides to its new place instead of jumping.
              var gap = Math.max(saved.top, stickyTop) - bar.getBoundingClientRect().top;
              if (Math.abs(gap) > 1) move(bar, "translateY(" + gap + "px)");
              var ind = bar.querySelector(".tab-indicator");
              if (ind && saved.ind) {
                var r = ind.getBoundingClientRect();
                move(ind, "translateX(" + (saved.ind.left - r.left) + "px) scaleX(" + saved.ind.width / r.width + ")");
              }
              move(panel, "translateX(" + 40 * saved.dir + "px)");
              return;
            }
          }

          if (saved && saved.kind === "reorder") {
            var box = document.querySelector("[data-keep-place]");
            if (box) {
              keep(scrollY + box.getBoundingClientRect().top - Math.max(saved.top, stickyTop));
              var top0 = box.getBoundingClientRect().top;
              Array.prototype.forEach.call(document.querySelectorAll("[data-reorder] > [id]"), function (row) {
                var was = saved.rows[row.id];
                var now = row.getBoundingClientRect().top - top0;
                if (was == null) move(row, "translateY(14px)");
                else if (Math.abs(was - now) > 1) move(row, "translateY(" + (was - now) + "px)", 420);
              });
              return;
            }
          }

          var nav = performance.getEntriesByType("navigation")[0];
          var fromSite = false;
          try { fromSite = new URL(document.referrer).origin === location.origin; } catch (x) {}
          if (fromSite && (!nav || nav.type === "navigate")) move(document.getElementById("main"), "translateY(14px)");
        };
        if ("onpagereveal" in window) addEventListener("pagereveal", arrive);
        else document.addEventListener("DOMContentLoaded", arrive);
      })();
    </script>
    <%!-- Fonts are served by the site (assets/css/fonts.css): nothing blocks the
         first paint on another origin. Inter Tight sets the titles and text, so
         it starts first; the monospace eyebrows can wait. --%>
    <link
      rel="preload"
      href="/fonts/inter-tight-latin-v5.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-500-v5.woff2"
      as="font"
      type="font/woff2"
      fetchpriority="low"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <%!-- Wait for the content (the end of <main>, so the tab bar and the tables
         are there) before the first paint: the page arrival above needs them. --%>
    <link rel="expect" href="#vt-ready" blocking="render" />
    <%!-- Prepare the next page on hover (prerender) so a click shows it at once.
         Only public pages: never the API, sign-in, the member space, discussions or admin. --%>
    <script :if={assigns[:public]} type="speculationrules">
      {"prerender": [{"where": {"and": [
        {"href_matches": "/*"},
        {"not": {"href_matches": ["/admin/*", "/admin", "/api/*", "/*/mon-espace*", "/*/my-space*", "/*/connexion*", "/*/sign-in*", "/unsubscribe/*", "/*/discussion*"]}},
        {"not": {"selector_matches": "[data-method], [download], [rel~=nofollow], [target]"}}
      ]}, "eagerness": "moderate"}]}
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- The LiveView client, for LiveView pages only (SyliAtlasWeb.LiveAssets). --%>
    <script
      :if={assigns[:live_js]}
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/live.js"}
    >
    </script>
  </head>
  <body>
    {@inner_content}
    <section id="toasts" class="toasts" aria-label={gettext("Notifications")} aria-live="polite">
    </section>
    <script type="application/json" id="ui-strings">
      <%= Phoenix.HTML.raw(SyliAtlasWeb.MapComponents.json_for_script(SyliAtlasWeb.Layouts.ui_strings())) %>
    </script>
  </body>
</html>
