<Layouts.public locale={@locale} current={:home} alternates={@alternates}>
  <section class="hero">
    <div class="band" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="stack gap-4">
        <p class="eyebrow">{gettext("IMF data · 54 countries · checked every day")}</p>
        <h1 class="display">{gettext("African economies, country by country.")}</h1>
        <p class="lead">
          {gettext(
            "Growth, living standards, debt and inflation: sourced figures for every African country, from 2015 to the 2030 projections, to compare freely."
          )}
        </p>
        <.search_form locale={@locale} />
        <div class="row gap-1">
          <span class="subtle small">{gettext("Often viewed:")}</span>
          <a :for={a <- @popular} class="chip" href={Paths.area(@locale, "country", a["slug"])}>
            {a["name"]}
            <RatingComponents.rating_chip entry={
              SyliAtlas.Ratings.for_country(@ratings, a["code"])
            } />
          </a>
        </div>
      </div>
      <.headline_window
        africa={@africa}
        world={@world}
        from={@from}
        to={@to}
        locale={@locale}
      />
    </div>
  </section>

  <div class="strip">
    <div class="wrap">
      <span class="pill pill-ok">{gettext("Up to date")}</span>
      <span class="muted">{gettext("Source: IMF, %{label}", label: @edition && @edition["label"])}</span>
      <span :if={@last_checked_at} class="src">
        {gettext("Last check: %{date}", date: checked_at(@last_checked_at))}
      </span>
      <a class="strip-link" href={Paths.method(@locale)}>{gettext("How we update")} →</a>
    </div>
  </div>

  <.section :if={@map_selected} id="carte">
    <.section_head eyebrow={gettext("The map")} title={gettext("Africa at a glance.")}>
      <:intro>
        {gettext("Touch a country to see its figures. The colour follows the chosen indicator.")}
      </:intro>
    </.section_head>
    <.map_section
      countries={@map_countries}
      indicator={@map_indicator}
      selected={@map_selected}
      from={@map_from}
      to={@map_to}
      locale={@locale}
      ratings={@ratings}
    />
  </.section>

  <.section variant="alt">
    <.section_head
      eyebrow={gettext("Start with a question")}
      title={gettext("The answers people look for, in figures.")}
    />
    <div class="grid grid-3">
      <.question_card
        href={Paths.ranking(@locale) <> "?mode=change"}
        eyebrow={gettext("Growth")}
        title={gettext("Which African countries grew the most since %{year}?", year: @from)}
        subtitle={gettext("GDP in current dollars, %{from} → %{to}", from: @from, to: @to)}
        cta={gettext("See the full ranking")}
      >
        <.list_row
          :for={r <- @top}
          label={r["name"]}
          value={change(r["value"], "gdp_usd_bn", @locale)}
          tone={tone(r["value"], "gdp_usd_bn")}
        />
      </.question_card>
      <.question_card
        href={Paths.regions(@locale)}
        eyebrow={gettext("Regions")}
        title={gettext("Which region of Africa grows fastest?")}
        subtitle={gettext("GDP in current dollars, %{from} → %{to}", from: @from, to: @to)}
        cta={gettext("Compare the five regions")}
      >
        <.list_row
          :for={r <- Enum.take(@regions, 2) ++ Enum.take(@regions, -1)}
          label={r["profile"]["name"][@locale]}
          value={change(r["period"]["changes"]["gdp_usd_bn"], "gdp_usd_bn", @locale)}
          tone={tone(r["period"]["changes"]["gdp_usd_bn"], "gdp_usd_bn")}
        />
      </.question_card>
      <.question_card
        href={Paths.ranking(@locale) <> "?mode=change&order=asc"}
        eyebrow={gettext("Weakest")}
        title={gettext("Which economies grew the least since %{year}?", year: @from)}
        subtitle={gettext("GDP in current dollars, %{from} → %{to}", from: @from, to: @to)}
        cta={gettext("See all countries")}
      >
        <.list_row
          :for={r <- @bottom}
          label={r["name"]}
          value={change(r["value"], "gdp_usd_bn", @locale)}
          tone={tone(r["value"], "gdp_usd_bn")}
        />
      </.question_card>
    </div>
  </.section>

  <RatingComponents.home_ratings
    :if={@ratings && @ratings["rated"] > 0}
    doc={@ratings}
    locale={@locale}
  />

  <.section variant="alt">
    <.section_head
      eyebrow={gettext("The continent in %{year}", year: @to)}
      title={gettext("Five regions, very different paths.")}
    >
      <:actions>
        <a class="btn btn-secondary" href={Paths.regions(@locale)}>{gettext("Compare the regions")} →</a>
      </:actions>
    </.section_head>
    <.continent_stats africa={@africa} world={@world} from={@from} to={@to} locale={@locale} />
    <.region_table regions={@regions} from={@from} to={@to} locale={@locale} />
    <p class="src">
      {gettext("IMF, %{label} · regional totals computed by Syli Atlas (African Union regions)",
        label: @edition && @edition["label"]
      )}
    </p>
  </.section>

  <.section variant="deep">
    <.section_head
      eyebrow={gettext("Why Syli Atlas")}
      title={gettext("Figures you can check, quote and reuse.")}
    />
    <div class="grid grid-4">
      <.feature n="01" title={gettext("Every figure has its source")}>
        {gettext("Institution, edition and copy date are shown next to the figures.")}
      </.feature>
      <.feature n="02" title={gettext("Checked every day")}>
        {gettext(
          "A job asks the sources every morning and publishes as soon as a new edition is out."
        )}
      </.feature>
      <.feature n="03" title={gettext("Open data")}>
        {gettext("Download every profile as CSV or query the public API, free of charge.")}
      </.feature>
      <.feature n="04" title={gettext("Discussed openly")}>
        {gettext("Every profile has a moderated discussion to ask a question or report an error.")}
      </.feature>
    </div>
    <.install_card />
  </.section>
</Layouts.public>
