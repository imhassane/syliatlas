<Layouts.public locale={@locale} current={:method} alternates={@alternates}>
  <.section>
    <div class="prose stack gap-4" id="about">
      <nav aria-label={gettext("Breadcrumb")}>
        <ol class="crumbs">
          <li><a href={Paths.home(@locale)}>Syli Atlas</a></li>
          <li aria-current="page">परिचय</li>
        </ol>
      </nav>
      <p class="eyebrow">परिचय</p>
      <h1 class="h1">सिली एटलस: सत्यापन योग्य आँकड़ों में अफ़्रीकी अर्थव्यवस्थाएँ।</h1>
      <p class="lead">
        सिली एटलस 54 अफ़्रीकी देशों के आर्थिक आँकड़े एक जगह लाता है: विकास, जीडीपी, ऋण, मुद्रास्फीति, व्यापार, जीवन स्तर, संप्रभु रेटिंग और शेयर बाज़ार, सात भाषाओं में। यह साइट निःशुल्क और गैर-व्यावसायिक है, और इसके लिए किसी खाते की ज़रूरत नहीं है।
      </p>

      <h2 class="h2">हर आँकड़ा अपना स्रोत बताता है</h2>
      <p>
        शृंखलाएँ सबसे पहले आईएमएफ़ के वर्ल्ड इकोनॉमिक आउटलुक ({@edition_label}) से आती हैं, फिर विश्व बैंक, CEPII (BACI), आईएमएफ़ और विश्व बैंक के ऋण स्थिरता विश्लेषणों, रेटिंग एजेंसियों और शेयर बाज़ारों के लिए MansaAPI से। हर शृंखला के नीचे स्रोत, उसका संस्करण और तारीख़ लिखी है; उनके पुनः उपयोग की शर्तें
        <a href={Paths.method(@locale)}>पद्धति और स्रोत</a>
        पृष्ठ पर हैं.
      </p>
      <p>
        क्षेत्रीय योग, रैंक और किसी अवधि में बदलाव सिली एटलस स्वयं गणना करता है और उन्हें इसी रूप में प्रस्तुत करता है। वह स्रोतों के आँकड़ों में कभी बदलाव नहीं करता।
      </p>

      <h2 class="h2">अद्यतन</h2>
      <p>
        स्रोतों की हर दिन जाँच होती है। आईएमएफ़ का नया संस्करण आयात किया जाता है, जाँचा जाता है, फिर प्रकाशित किया जाता है; शेयर बाज़ार हर बंद के बाद अद्यतन होते हैं (दिन के अंत के भाव, लाइव नहीं)। संप्रभु रेटिंग एजेंसियों की घोषणाओं से ली जाती हैं।
      </p>

      <h2 class="h2" id="cite">सिली एटलस का हवाला कैसे दें</h2>
      <p>मूल स्रोत और पृष्ठ का हवाला दें, साथ में पढ़ने की तारीख़:</p>
      <p class="small mono cite" dir="auto">
        Syli Atlas, आईएमएफ़ के अनुसार, {@edition_label}, {SyliAtlasWeb.Seo.url(
          Paths.area(@locale, "country", "senegal")
        )}, देखा गया {SyliAtlasWeb.Dates.day_month_year(
          Date.utc_today().day,
          Date.utc_today().month,
          Date.utc_today().year,
          @locale,
          :long
        )}.
      </p>
      <p>
        सिली एटलस जो गणना करता और लिखता है (योग, रैंक, बदलाव, वाक्य, चार्ट और चित्र) वह
        <a
          href={SyliAtlasWeb.Seo.license_url()}
          rel="license"
        >क्रिएटिव कॉमन्स एट्रिब्यूशन 4.0 लाइसेंस (CC BY 4.0)</a>
        के अंतर्गत है: व्यावसायिक उपयोग सहित मुक्त पुनः उपयोग, सिली एटलस के श्रेय और पृष्ठ के लिंक के साथ। स्रोतों के आँकड़ों पर उनकी अपनी शर्तें लागू रहती हैं (<a href={Paths.method(@locale) <> "#reuse"}>विवरण</a>).
      </p>
      <p>
        हर प्रोफ़ाइल CSV में डाउनलोड की जा सकती है और <a href={Paths.api(@locale)}>JSON API</a>
        से क्वेरी की जा सकती है। शेयर भाव केवल साइट पर रहते हैं: उनके स्रोत का लाइसेंस उन्हें दोबारा वितरित करने की अनुमति नहीं देता।
      </p>

      <h2 class="h2">जानकारी, सलाह नहीं</h2>
      <p>
        सिली एटलस जानकारी देता है; वह निवेश सलाह नहीं देता। अनुमान आईएमएफ़ के हैं और हर संस्करण के साथ बदलते हैं।
      </p>

      <h2 class="h2">हमें लिखें</h2>
      <p :if={@contact_email}>
        कोई त्रुटि, जोड़ने लायक कोई स्रोत, कोई प्रश्न: <a href={"mailto:" <> @contact_email}>{@contact_email}</a>.
      </p>
      <p :if={!@contact_email}>
        कोई त्रुटि या जोड़ने लायक स्रोत: <a href={Paths.accessibility(@locale)}>सुगम्यता</a>
        पृष्ठ पर भी बताया गया है कि हमसे कैसे संपर्क करें।
      </p>
    </div>
  </.section>
</Layouts.public>
