<Layouts.public locale={@locale} current={:themes} alternates={@alternates}>
  <.section>
    <nav aria-label={gettext("Breadcrumb")}>
      <ol class="crumbs">
        <li><a href={Paths.home(@locale)}>Syli Atlas</a></li>
        <li><a href={Paths.communities(@locale)}>{gettext("Economic communities")}</a></li>
        <li aria-current="page">{@name}</li>
      </ol>
    </nav>
    <.section_head level={1} eyebrow={@community.name[@locale]} title={@name}>
      <:intro>{@answer}</:intro>
    </.section_head>

    <.stat_grid>
      <:stat
        id="gdp"
        label={gettext("GDP %{year}", year: @year)}
        value={value(@summary.gdp, "gdp_usd_bn", @locale)}
      >
        {gettext("sum of the members")}
      </:stat>
      <:stat
        id="population"
        label={gettext("Population %{year}", year: @year)}
        value={value(@summary.population, "population_m", @locale)}
      >
        {gettext("%{n} countries", n: length(@community.members))}
      </:stat>
      <:stat
        id="growth"
        label={gettext("Growth %{year}", year: @year)}
        value={value(@summary.growth, "real_gdp_growth", @locale)}
      >
        {gettext("weighted by GDP in PPP")}
      </:stat>
      <:stat
        id="debt"
        label={gettext("Public debt %{year}", year: @year)}
        value={value(@summary.debt, "public_debt_pct_gdp", @locale)}
      >
        {gettext("of GDP, weighted by GDP in dollars")}
      </:stat>
    </.stat_grid>

    <.card id="members">
      <div class="pad">
        <.card_head
          title={gettext("Members")}
          subtitle={gettext("Ranked by GDP in %{year}", year: @year)}
        />
      </div>
      <.data_table id="members-table" caption={gettext("Members")} rows={@members} wide>
        <:head :let={m} label={gettext("Country")}>
          <a href={Paths.area(@locale, "country", m.slug)}>{m.name}</a>
        </:head>
        <:col :let={m} label={gettext("GDP %{year}", year: @year)}>
          {value(m.gdp, "gdp_usd_bn", @locale)}
        </:col>
        <:col :let={m} label={gettext("Growth")}>
          <span class={tone(m.growth, "real_gdp_growth")}>{value(
            m.growth,
            "real_gdp_growth",
            @locale
          )}</span>
        </:col>
        <:col :let={m} label={gettext("Public debt")}>
          <a href={Paths.country_tab(@locale, m.slug, :finances)}>{value(
            m.debt,
            "public_debt_pct_gdp",
            @locale
          )}</a>
        </:col>
        <:col :let={m} label={gettext("Fiscal balance")}>
          {value(m.balance, "fiscal_balance_pct_gdp", @locale)}
        </:col>
        <:col :let={m} :if={@community[:zone]} label={gettext("Convergence criteria")}>
          <span
            :for={c <- m.convergence.criteria}
            class={["pill no-dot", status_class(c.status)]}
            title={c.key}
          >
            {status_mark(c.status)}
          </span>
        </:col>
      </.data_table>
      <.card_foot>
        {gettext(
          "Source: IMF, %{edition} · totals and criteria: Syli Atlas calculation · membership as of %{date}",
          edition: @edition,
          date: SyliAtlas.Economy.Communities.as_of()
        )}
      </.card_foot>
    </.card>

    <nav class="card pad stack gap-2" aria-label={gettext("Other communities")}>
      <p class="eyebrow">{gettext("Other communities")}</p>
      <div class="row gap-2">
        <a
          :for={o <- @others}
          class="btn btn-secondary"
          href={Paths.community(@locale, o.slug[@locale])}
        >{o.short[@locale]}</a>
      </div>
    </nav>
  </.section>
</Layouts.public>
