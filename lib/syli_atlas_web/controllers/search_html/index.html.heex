<Layouts.public locale={@locale} current={:search} alternates={@alternates}>
  <.section>
    <.section_head level={1} title={gettext("Search")} />
    <.search_form locale={@locale} value={@q} id="search-page-input" autofocus />

    <.card :if={@search && @search["answer"]} id="search-answer" class="pad stack gap-1">
      <% a = @search["answer"] %>
      <p class="eyebrow">{a["name"]} · {a["label"]} · {a["year"]}</p>
      <p class="big">{a["value"]}</p>
      <p :if={a["growth"]} class="small muted">
        {gettext("Growth %{year}: %{value}", year: a["year"], value: a["growth"])}
      </p>
      <p class="src">
        {gettext("Source: %{source}", source: a["source"])} ·
        <a href={a["path"]}>
          {gettext("See the details")}<span class="vh"> : {a["name"]}, {a["label"]}</span>
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </.card>

    <div :if={@search && @search["results"] == []} class="stack gap-2" id="search-none">
      <p class="muted">{gettext("Nothing matches “%{q}”.", q: @q)}</p>
      <p class="small muted">
        {gettext(
          "Try a country name (Côte d'Ivoire, Ivory Coast, CIV), a community (UEMOA, ECOWAS), or a theme: debt, inflation, ratings."
        )}
      </p>
    </div>

    <.card :if={@search && @search["results"] != []} id="search-results">
      <ul class="link-list">
        <li :for={r <- @search["results"]}>
          <a href={r["path"]}>
            <span>{r["label"]}</span>
            <span class="small subtle">{r["kind"]}</span>
          </a>
        </li>
      </ul>
    </.card>

    <div class="stack gap-3">
      <h2 class="h2">{gettext("All countries")}</h2>
      <ul class="az">
        <li :for={
          c <-
            Enum.sort_by(
              @countries,
              &SyliAtlas.Geo.Area.normalize(SyliAtlas.Geo.Area.name(&1, @locale))
            )
        }>
          <a href={Paths.area(@locale, c)}>{SyliAtlas.Geo.Area.name(c, @locale)}</a>
        </li>
      </ul>
    </div>
  </.section>
</Layouts.public>
