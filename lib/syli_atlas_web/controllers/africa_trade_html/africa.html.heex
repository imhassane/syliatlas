<Layouts.public locale={@locale} current={:trade} alternates={@alternates}>
  <section class="section-alt market-hero" id="africa-hero">
    <div class="wrap market-hero-wrap">
      <nav aria-label={gettext("Breadcrumb")}>
        <ol class="crumbs">
          <li><a href={Paths.home(@locale)}>Syli Atlas</a></li>
          <li aria-current="page">{gettext("Africa's trade")}</li>
        </ol>
      </nav>
      <div class="market-hero-row">
        <div class="market-hero-title">
          <h1 class="market-h1">{gettext("Africa's trade")}</h1>
          <p class="muted market-hero-lead" id="africa-answer" data-answer>{@answer}</p>
        </div>
        <dl class="market-summary" id="africa-summary">
          <div>
            <dt>{gettext("Exports")}</dt>
            <dd class="num">{usd(@a["exports"], @locale)}</dd>
          </div>
          <div>
            <dt>{gettext("Imports")}</dt>
            <dd class="num">{usd(@a["imports"], @locale)}</dd>
          </div>
          <div>
            <dt>{gettext("Balance")}</dt>
            <dd class={["num", if(@a["exports"] >= @a["imports"], do: "up", else: "down")]}>
              {if @a["exports"] >= @a["imports"], do: "+", else: "−"}{usd(
                abs(@a["exports"] - @a["imports"]),
                @locale
              )}
            </dd>
          </div>
          <div>
            <dt>{gettext("Sold within Africa")}</dt>
            <dd class="num">{pct(@a["intra_share"], @locale)}</dd>
          </div>
        </dl>
      </div>
      <p class="src">
        {source(@doc)} · {gettext("the 54 countries taken together, %{year}", year: @doc["year"])}
      </p>
    </div>
  </section>

  <.section id="ventes-achats">
    <.section_head
      eyebrow={gettext("Products")}
      title={gettext("What Africa sells, what it buys")}
    >
      <:intro>
        {gettext(
          "Main products (HS 4-digit headings), as a share of Africa's exports and imports. For exports, Africa's share of the world's exports of each product."
        )}
      </:intro>
    </.section_head>
    <div class="grid grid-2">
      <.card pad class="stack gap-3" id="africa-exports">
        <h2 class="h3">{gettext("What Africa sells")}</h2>
        <div class="table-box">
          <table class="table trade-products" id="africa-exports-table">
            <caption class="vh">{gettext("What Africa sells")}</caption>
            <thead>
              <tr>
                <th scope="col" class="l">{gettext("Product")}</th>
                <th scope="col">{gettext("Share of exports")}</th>
                <th scope="col">{gettext("Share of the world")}</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={r <- @a["top_exports"]} id={"africa-export-" <> r["code"]}>
                <th scope="row" class="l">{heading(r["code"], @locale)}</th>
                <td class="num" data-label={gettext("Share of exports")}>
                  <b>{pct(r["share"], @locale)}</b>
                </td>
                <td class="num" data-label={gettext("Share of the world")}>
                  {pct(r["world_share"], @locale)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </.card>
      <.card pad class="stack gap-3" id="africa-imports">
        <h2 class="h3">{gettext("What Africa buys")}</h2>
        <div class="table-box">
          <table class="table trade-products" id="africa-imports-table">
            <caption class="vh">{gettext("What Africa buys")}</caption>
            <thead>
              <tr>
                <th scope="col" class="l">{gettext("Product")}</th>
                <th scope="col">{gettext("Share of imports")}</th>
                <th scope="col">{gettext("Value")}</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={r <- @a["top_imports"]} id={"africa-import-" <> r["code"]}>
                <th scope="row" class="l">{heading(r["code"], @locale)}</th>
                <td class="num" data-label={gettext("Share of imports")}>
                  <b>{pct(r["share"], @locale)}</b>
                </td>
                <td class="num" data-label={gettext("Value")}>{usd(r["value"], @locale)}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </.card>
    </div>
    <p class="src">{source(@doc)} · {gettext("shares: Syli Atlas calculation")}</p>
  </.section>

  <.section id="transformation" variant="alt">
    <.section_head
      eyebrow={gettext("Processing")}
      title={gettext("Africa sells raw, buys processed")}
    >
      <:intro>
        {gettext(
          "Raw or barely processed materials make %{raw} of what Africa sells, and %{raw_imports} of what it buys.",
          raw: pct(SyliAtlas.Trade.raw_share(@a["stages"]["exports"]), @locale),
          raw_imports: pct(SyliAtlas.Trade.raw_share(@a["stages"]["imports"]), @locale)
        )}
      </:intro>
    </.section_head>
    <.card pad class="stack gap-3" id="africa-stages">
      <div class="table-box" tabindex="0" role="region" aria-labelledby="africa-stages-caption">
        <table class="table" id="africa-stages-table">
          <caption class="vh" id="africa-stages-caption">
            {gettext("Stage of processing of Africa's trade")}
          </caption>
          <thead>
            <tr>
              <th scope="col" class="l"></th>
              <th :for={{_, label} <- stages()} scope="col">{label}</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={
              {key, label} <- [{"exports", gettext("Exports")}, {"imports", gettext("Imports")}]
            }>
              <th scope="row" class="l">{label}</th>
              <td :for={{s, _} <- stages()} class="num">{pct(@a["stages"][key][s], @locale)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="src">
        {gettext(
          "Stage of processing: United Nations, Broad Economic Categories (BEC rev. 5); gold, precious stones and unwrought metals grouped by Syli Atlas · %{source}",
          source: source(@doc)
        )}
      </p>
    </.card>
  </.section>

  <.section id="partenaires">
    <.section_head
      eyebrow={gettext("Partners")}
      title={gettext("Who Africa trades with")}
    >
      <:intro>
        {gettext(
          "Outside Africa, as a share of all African exports and imports. Trade between African countries is %{intra} of exports.",
          intra: pct(@a["intra_share"], @locale)
        )}
      </:intro>
    </.section_head>
    <div class="grid grid-2">
      <.card pad class="stack gap-3" id="africa-clients">
        <h2 class="h3">{gettext("Clients outside Africa")}</h2>
        <.share_bars
          id="africa-clients-bars"
          locale={@locale}
          items={
            for r <- @a["clients"],
                do: %{
                  label: name(@countries, r["code"], @locale),
                  share: r["share"],
                  flag: r["code"]
                }
          }
        />
      </.card>
      <.card pad class="stack gap-3" id="africa-suppliers">
        <h2 class="h3">{gettext("Suppliers outside Africa")}</h2>
        <.share_bars
          id="africa-suppliers-bars"
          locale={@locale}
          alt
          items={
            for r <- @a["suppliers"],
                do: %{
                  label: name(@countries, r["code"], @locale),
                  share: r["share"],
                  flag: r["code"]
                }
          }
        />
      </.card>
    </div>
  </.section>

  <.section id="exportateurs" variant="alt">
    <div class="card market-table" id="africa-exporters">
      <div class="card-head">
        <h2 class="h2">{gettext("The 54 countries, by exports")}</h2>
        <p class="small muted">
          {gettext("Exports of goods %{year} and share of Africa's total", year: @doc["year"])}
        </p>
      </div>
      <div
        class="table-box table-scroll"
        tabindex="0"
        role="region"
        aria-labelledby="africa-exporters-caption"
      >
        <table class="table table-stack market-list trade-rank" id="africa-exporters-table">
          <caption class="vh" id="africa-exporters-caption">
            {gettext("The 54 countries, by exports")}
          </caption>
          <thead>
            <tr>
              <th scope="col" class="l trade-rank-n">{gettext("Rank")}</th>
              <th scope="col" class="l">{gettext("Country")}</th>
              <th scope="col">{gettext("Exports")}</th>
              <th scope="col">{gettext("Share of Africa")}</th>
              <th scope="col">{gettext("Imports")}</th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={{r, i} <- Enum.with_index(@a["exporters"], 1)}
              id={"africa-row-" <> r["code"]}
            >
              <td class="l num trade-rank-n" data-label={gettext("Rank")}>{i}</td>
              <th scope="row" class="l">
                <.country code={r["code"]} countries={@countries} locale={@locale} />
              </th>
              <td class="num" data-label={gettext("Exports")}>{usd(r["value"], @locale)}</td>
              <td class="num" data-label={gettext("Share of Africa")}>
                <b>{pct(r["share"], @locale)}</b>
              </td>
              <td class="num" data-label={gettext("Imports")}>
                {usd(
                  Enum.find_value(@a["importers"], &(&1["code"] == r["code"] && &1["value"])),
                  @locale
                )}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="src card-foot">{source(@doc)}</p>
    </div>
  </.section>

  <.section :if={length(@history) > 2} id="historique">
    <.section_head
      eyebrow={gettext("Since %{year}", year: elem(hd(@history), 0))}
      title={gettext("%{years} years of African trade", years: length(@history))}
    />
    <.card pad>
      <.history_chart
        id="africa-history"
        points={@history}
        label={
          gettext("Exports and imports of goods of Africa, %{y0}–%{y1}, in US dollars",
            y0: elem(hd(@history), 0),
            y1: elem(List.last(@history), 0)
          )
        }
        locale={@locale}
        source={history_source(@doc)}
      />
    </.card>
  </.section>

  <.section id="produits" variant="alt">
    <.section_head
      eyebrow={gettext("Product by product")}
      title={gettext("Africa's main products")}
    >
      <:actions>
        <a class="btn btn-secondary btn-sm" href={TradeTopics.products_path(@locale)}>{gettext(
          "All products"
        )} →</a>
      </:actions>
    </.section_head>
    <ul class="product-grid" id="africa-products">
      <li :for={c <- @products |> Enum.sort_by(&(-(&1.value || 0))) |> Enum.take(8)}>
        <a href={c.path} class="card product-card">
          <span class="product-card-name">{c.name}</span>
          <b class="num product-card-value">{usd(c.value, @locale)}</b>
          <span class="small muted">
            {if c.kind == :export,
              do: gettext("exported · %{share} of the world", share: pct(c.world_share, @locale)),
              else: gettext("bought by Africa")}
          </span>
        </a>
      </li>
    </ul>
  </.section>

  <.section id="questions-afrique">
    <div class="trade-cols">
      <div class="stack gap-3 trade-main">
        <h2 class="h2">{gettext("Questions")}</h2>
        <.faq items={@faq} />
      </div>
      <div class="stack gap-3 trade-side" id="africa-links">
        <h2 class="h3">{gettext("Data and links")}</h2>
        <a
          class="btn btn-primary"
          href={TradeTopics.africa_csv_path(@locale)}
          download
          id="africa-csv"
        >
          {gettext("Download the data (CSV)")}
        </a>
        <ul class="link-list">
          <li :for={id <- TradeTopics.rankings()}>
            <a href={TradeTopics.ranking_path(@locale, id)}>{SyliAtlasWeb.TradeRankingController.question(
              id
            )}</a>
          </li>
          <li><a href={Paths.communities(@locale)}>{gettext("Economic communities")}</a></li>
        </ul>
      </div>
    </div>
  </.section>
</Layouts.public>
