<Layouts.public locale={@locale} current={:markets} alternates={@alternates}>
  <.section tight={:bottom} class="profile-head">
    <ProfileComponents.entity_head
      crumbs={[
        {"Syli Atlas", Paths.home(@locale)},
        {gettext("Stock exchanges"), Paths.markets(@locale)},
        {@e["short_name"], nil}
      ]}
      title={@e["short_name"]}
      subtitle={@e["name"] != @e["short_name"] && @e["name"]}
      kpis_id="exchange-kpis"
      class="exchange-head"
    >
      <:mark>
        <%= case @e["countries"] do %>
          <% [code] -> %>
            <SyliAtlasWeb.UI.flag code={code} size="lg" />
          <% _ -> %>
            <ProfileComponents.region_mark />
        <% end %>
      </:mark>
      <:actions>
        <SyliAtlasWeb.AccountComponents.follow
          kind="exchange"
          ref={@e["code"]}
          locale={@locale}
          path={SyliAtlasWeb.Paths.exchange(@locale, @e["code"])}
          alert_market={{@e["code"], nil}}
        />
        <a
          :if={@simulable}
          class="btn btn-secondary"
          id="exchange-simulate"
          href={
            Paths.simulator(@locale) <> "?" <> URI.encode_query(%{"indice" => @e["code"]})
          }
        >
          {gettext("Simulate a placement")}
        </a>
      </:actions>
      <:chips>
        <span class="pill pill-neutral no-dot">
          {if length(@e["countries"]) > 1,
            do: gettext("Regional exchange"),
            else: gettext("Stock exchange")}
        </span>
        <span class="pill pill-neutral no-dot">{region_label(@e["region"])}</span>
        <a
          :for={c <- @e["country_names"]}
          class="pill pill-neutral no-dot"
          href={country_href(c, @locale)}
        >
          {SyliAtlas.Locales.pick(c["name"], @locale)}
        </a>
      </:chips>
      <:kpi
        id="index"
        label={@e["index_name"] || gettext("Main index")}
        value={price(@doc["index"]["value"], @locale)}
      >
        <.freshness index={@doc["index"]} locale={@locale} />
      </:kpi>
      <:kpi
        id="session"
        label={gettext("Session")}
        value={pct(@doc["index"]["change_pct"], @locale)}
        tone={tone(@doc["index"]["change_pct"])}
      >
        <span :if={@doc["index"]["flags"]["suspect"]} class="pill pill-warn no-dot">
          {gettext("to check")}
        </span>
        <span :if={!@doc["index"]["flags"]["suspect"]}>{gettext("change of the index")}</span>
      </:kpi>
      <:kpi
        id="ytd"
        label={gettext("Since 1 January")}
        value={ytd(@doc["index"]["ytd_pct"], @locale)}
        tone={tone(@doc["index"]["ytd_pct"])}
      >
        {gettext("as given by the source")}
      </:kpi>
      <:kpi
        id="traded"
        label={gettext("Traded that day")}
        value={money_amount(@doc["session"]["value"], @e["currency"], @locale)}
      >
        {usd(SyliAtlas.Market.to_usd(@doc["session"]["value"], @e["currency"], @fx), @locale)}
        <span :if={@doc["session"]["top"]}>
          · {gettext("%{share} % on %{name}",
            share: number(@doc["session"]["top"]["share"], 0, @locale),
            name: @doc["session"]["top"]["name"]
          )}
        </span>
      </:kpi>
    </ProfileComponents.entity_head>
  </.section>

  <.section class="tab-intro">
    <div class="stack gap-1">
      <p class="lead" data-answer>{@answer}</p>
      <p class="src">
        <.credit
          sources={@doc["sources"]}
          date={@doc["index"]["date"] || @doc["session"]["date"]}
          locale={@locale}
        />
      </p>
    </div>
  </.section>

  <.section>
    <div class="grid grid-2 market-grid">
      <.card pad>
        <.card_head
          title={@e["index_name"] || gettext("Main index")}
          subtitle={gettext("Points · sessions received by Syli Atlas")}
        />
        <.index_chart
          :if={length(@doc["history"]) >= 2}
          id="index-chart"
          history={@doc["history"]}
          label={@answer}
          locale={@locale}
        />
        <div :if={length(@doc["history"]) < 2} class="market-empty-chart" id="index-chart-empty">
          <p class="h3">{gettext("History being built")}</p>
          <p class="muted small">
            {gettext(
              "Every close is recorded from the first import on. The curve appears from the second session."
            )}
          </p>
        </div>
      </.card>
      <.card pad class="stack gap-3">
        <.card_head
          title={gettext("Session of %{date}", date: day(@doc["session"]["date"], @locale))}
          subtitle={gettext("%{count} listed securities", count: @e["listed"])}
        />
        <% s = @doc["session"]
        total = max(s["up"] + s["down"] + s["flat"] + s["none"], 1) %>
        <div
          class="market-breadth"
          role="img"
          aria-label={
            gettext("%{up} up, %{flat} unchanged, %{down} down, %{none} without trade",
              up: s["up"],
              flat: s["flat"],
              down: s["down"],
              none: s["none"]
            )
          }
        >
          <span class="b-up" style={"width: #{s["up"] / total * 100}%"}></span>
          <span class="b-flat" style={"width: #{s["flat"] / total * 100}%"}></span>
          <span class="b-down" style={"width: #{s["down"] / total * 100}%"}></span>
          <span class="b-none" style={"width: #{s["none"] / total * 100}%"}></span>
        </div>
        <div>
          <.list_row label={gettext("Up")} value={to_string(s["up"])} tone="up" />
          <.list_row label={gettext("Unchanged")} value={to_string(s["flat"])} />
          <.list_row label={gettext("Down")} value={to_string(s["down"])} tone="down" />
          <.list_row label={gettext("Without trade")} value={to_string(s["none"])} />
        </div>
      </.card>
    </div>

    <div :if={@doc["movers_up"] != [] or @doc["movers_down"] != []} class="grid grid-2">
      <.card :for={
        {title, list} <- [
          {gettext("Biggest rises"), @doc["movers_up"]},
          {gettext("Biggest falls"), @doc["movers_down"]}
        ]
      }>
        <div class="pad">
          <.card_head title={title} subtitle={gettext("Securities traded that day")} />
        </div>
        <ol class="rank-list market-movers">
          <li :for={{m, i} <- Enum.with_index(list, 1)}>
            <span class="num subtle">{i}</span>
            <a href={Paths.security(@locale, @e["code"], m["ticker"])}>{m["name"]}
            <span class="mono small muted">{m["ticker"]}</span></a>
            <b class={["num", tone(m["change_pct"])]}>{pct(m["change_pct"], @locale)}</b>
          </li>
        </ol>
      </.card>
    </div>
  </.section>

  <.section id="securities" tight={:top}>
    <h2 class="h1">{gettext("Listed securities")}</h2>
    <.card>
      <div class="table-box">
        <table class="table table-stack market-securities" id="securities-table">
          <caption class="vh">
            {gettext("Securities listed on the %{exchange}", exchange: @e["short_name"])}
          </caption>
          <thead>
            <tr>
              <th scope="col" class="l">{gettext("Company")}</th>
              <th scope="col" class="l">{gettext("Code")}</th>
              <th scope="col">{pgettext("price", "Close")} ({@e["currency"]})</th>
              <th scope="col">{gettext("Daily change")}</th>
              <th scope="col">{gettext("Volume")}</th>
              <th scope="col">{gettext("Value traded")}</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={r <- @page.entries} id={"security-#{String.downcase(r["ticker"])}"}>
              <th scope="row" class="l">
                <a href={Paths.security(@locale, @e["code"], r["ticker"])}>{r["name"]}</a>
                <span
                  :if={security_flag(r)}
                  class={[
                    "pill no-dot market-flag",
                    if(elem(security_flag(r), 0) == :warn, do: "pill-warn", else: "pill-neutral")
                  ]}
                >{elem(security_flag(r), 1)}</span>
              </th>
              <td class="l mono small muted" data-label={gettext("Code")}>{r["ticker"]}</td>
              <td class="num" data-label={pgettext("price", "Close")}>
                {price(r["close"], @locale)}
              </td>
              <td data-label={gettext("Daily change")}>
                <b class={["num", tone(r["change_pct"])]}>{pct(r["change_pct"], @locale)}</b>
              </td>
              <td class="num" data-label={gettext("Volume")}>{integer(r["volume"], @locale)}</td>
              <td class="num" data-label={gettext("Value traded")}>
                {money_amount(r["value"], @e["currency"], @locale)}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="market-table-foot">
        <span class="src">{gettext(
          "Sorted by value traded · value = close × volume, computed by Syli Atlas"
        )}</span>
        <.list_pager page={@page} href={@page_href} />
      </div>
    </.card>
  </.section>

  <.section variant="alt">
    <div class="grid grid-2">
      <.card pad class="stack gap-3">
        <p class="eyebrow">{gettext("Where these figures come from")}</p>
        <.market_sources sources={@doc["sources"]} locale={@locale} />
        <p :if={@doc["issues"] != []} class="small muted">
          {gettext("Flagged on this page:")}
          {Enum.map_join(@doc["issues"], " · ", &issue_text(&1, @locale))}
        </p>
        <a class="market-more" href={Paths.method(@locale)}>{gettext("Method and sources")} →</a>
      </.card>
      <.card pad class="stack gap-2">
        <p class="eyebrow">{gettext("Cite this page")}</p>
        <p class="small mono cite">
          Syli Atlas, « {@e["short_name"]} », {attribution(
            @doc["sources"],
            @doc["index"]["date"],
            @locale
          )}. {SyliAtlasWeb.Seo.url(Paths.exchange(@locale, @e["code"]))}
        </p>
        <p class="small muted">{gettext("Information, not investment advice.")}</p>
      </.card>
    </div>
  </.section>

  <.section :if={@neighbours != []} tight={:top} id="other-exchanges">
    <nav class="card pad stack gap-2" aria-label={gettext("Other exchanges of the region")}>
      <p class="eyebrow">{gettext("Other exchanges of the region")}</p>
      <ul class="related-list">
        <li :for={x <- @neighbours}>
          <a href={Paths.exchange(@locale, x["exchange"]["code"])}>{x["exchange"]["name"]}</a>
        </li>
        <li><a href={Paths.etfs(@locale)}>{gettext("Funds exposed to Africa (ETF)")}</a></li>
        <li><a href={Paths.markets(@locale)}>{gettext("All exchanges")} →</a></li>
      </ul>
    </nav>
  </.section>
</Layouts.public>
