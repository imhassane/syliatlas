<Layouts.public locale={@locale} current={:markets} alternates={@alternates}>
  <.section tight={:bottom} class="profile-head">
    <ProfileComponents.entity_head
      crumbs={[
        {"Syli Atlas", Paths.home(@locale)},
        {gettext("Stock exchanges"), Paths.markets(@locale)},
        {@e["short_name"], Paths.exchange(@locale, @e["code"])},
        {@row["name"], nil}
      ]}
      title={@row["name"]}
      tag={@row["ticker"]}
      kpis_id="security-kpis"
      class="security-head"
    >
      <:mark>
        <%= cond do %>
          <% @country -> %>
            <SyliAtlasWeb.UI.flag code={@country["code"]} size="lg" />
          <% match?([_], @e["countries"]) -> %>
            <SyliAtlasWeb.UI.flag code={hd(@e["countries"])} size="lg" />
          <% true -> %>
            <ProfileComponents.monogram text={@row["ticker"]} />
        <% end %>
      </:mark>
      <:actions>
        <SyliAtlasWeb.AccountComponents.follow
          kind="security"
          ref={@e["code"] <> "/" <> @row["ticker"]}
          locale={@locale}
          path={SyliAtlasWeb.Paths.security(@locale, @e["code"], @row["ticker"])}
          alert_market={{@e["code"], @row["ticker"]}}
        />
      </:actions>
      <:chips>
        <span class="pill pill-neutral no-dot">
          {if @row["kind"] == "etf", do: gettext("Exchange-traded fund"), else: gettext("Share")}
        </span>
        <a :if={@country} class="pill pill-neutral no-dot" href={country_href(@country, @locale)}>
          {@country["name"][@locale]}
        </a>
        <a class="pill pill-neutral no-dot" href={Paths.exchange(@locale, @e["code"])}>
          {gettext("listed on the %{exchange}", exchange: @e["short_name"])}
        </a>
        <span
          :if={security_flag(@row)}
          class={[
            "pill no-dot",
            if(elem(security_flag(@row), 0) == :warn, do: "pill-warn", else: "pill-neutral")
          ]}
        >
          {elem(security_flag(@row), 1)}
        </span>
      </:chips>
      <:kpi id="close" label={gettext("Closing price")} value={price(@row["close"], @locale)}>
        {@row["currency"]}
        <span :if={
          usd(SyliAtlas.Market.to_usd(to_f(@row["close"]), @row["currency"], @fx), @locale)
        }>
          · {usd(SyliAtlas.Market.to_usd(to_f(@row["close"]), @row["currency"], @fx), @locale)}
        </span>
      </:kpi>
      <:kpi
        id="session"
        label={gettext("Session")}
        value={pct(@row["change_pct"], @locale)}
        tone={tone(@row["change_pct"])}
      >
        {day(@row["trade_date"], @locale)}
      </:kpi>
      <:kpi id="volume" label={gettext("Volume")} value={integer(@row["volume"], @locale)}>
        {gettext("securities traded")}
      </:kpi>
      <:kpi
        id="value"
        label={gettext("Value traded")}
        value={amount(@row["value"], @row["currency"], @locale)}
      >
        {usd(SyliAtlas.Market.to_usd(@row["value"], @row["currency"], @fx), @locale)}
      </:kpi>
      <:kpi
        id="share"
        label={gettext("Share of the exchange's trading")}
        value={if @share, do: number(@share, 0, @locale) <> " %", else: "—"}
      >
        {gettext("of the value traded that day")}
      </:kpi>
      <:kpi id="cap" label={gettext("Market capitalisation")} value="—">
        {gettext("not provided by the current source")}
      </:kpi>
    </ProfileComponents.entity_head>
  </.section>

  <.section class="tab-intro">
    <div class="stack gap-1">
      <p class="lead" data-answer>{@answer}</p>
      <p class="src">
        <.credit sources={@doc["sources"]} date={@row["trade_date"]} locale={@locale} />
      </p>
    </div>
  </.section>

  <.section>
    <.card pad>
      <.card_head
        title={gettext("Price history")}
        subtitle={
          gettext("Closes in %{currency} · sessions received by Syli Atlas",
            currency: @row["currency"]
          )
        }
      />
      <.index_chart
        :if={length(@history) >= 2}
        id="price-chart"
        history={@history}
        label={@answer}
        locale={@locale}
      />
      <div :if={length(@history) < 2} class="market-empty-chart" id="price-chart-empty">
        <p class="h3">{gettext("History being built")}</p>
        <p class="muted small">
          {gettext(
            "Every close is recorded from the first import on. Older history will come from an official or licensed source."
          )}
        </p>
      </div>
    </.card>

    <div class="grid grid-2">
      <.card>
        <div class="pad"><.card_head title={gettext("Security")} /></div>
        <table class="table">
          <caption class="vh">{gettext("Security")} {@row["ticker"]}</caption>
          <tbody>
            <tr>
              <th scope="row" class="l">{gettext("Code")}</th><td class="mono">
                {@row["ticker"]}
              </td>
            </tr>
            <tr>
              <th scope="row" class="l">{gettext("Exchange")}</th>
              <td>
                <a href={Paths.exchange(@locale, @e["code"])}>{@e["short_name"]}</a>
                <span :if={@e["mic"]} class="mono small muted">{@e["mic"]}</span>
              </td>
            </tr>
            <tr :if={@country}>
              <th scope="row" class="l">{gettext("Country")}</th>
              <td><a href={country_href(@country, @locale)}>{@country["name"][@locale]}</a></td>
            </tr>
            <tr>
              <th scope="row" class="l">{gettext("Currency")}</th><td class="mono">
                {@row["currency"]}
              </td>
            </tr>
            <tr :if={@row["issuer"]}>
              <th scope="row" class="l">{gettext("Issuer")}</th><td>{@row["issuer"]}</td>
            </tr>
            <tr :if={@row["isin"]}>
              <th scope="row" class="l">ISIN</th><td class="mono">{@row["isin"]}</td>
            </tr>
          </tbody>
        </table>
      </.card>
      <.card pad class="stack gap-3">
        <p class="eyebrow">{gettext("Where these figures come from")}</p>
        <p>
          {gettext(
            "Price, change and volume: %{source}. Value traded and share of trading: computed by Syli Atlas.",
            source: SyliAtlas.Market.Catalog.name(@row["source"] || "mansa")
          )}
        </p>
        <.market_sources sources={@doc["sources"]} locale={@locale} />
        <p class="small muted">{gettext("Information, not investment advice.")}</p>
        <a class="market-more" href={Paths.exchange(@locale, @e["code"])}>{gettext(
          "The %{exchange} page",
          exchange: @e["short_name"]
        )} →</a>
      </.card>
    </div>
  </.section>
</Layouts.public>
