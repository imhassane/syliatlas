<Layouts.public locale={@locale} current={:markets} alternates={@alternates}>
  <.section tight={:bottom} class="profile-head">
    <ProfileComponents.entity_head
      crumbs={[
        {"Syli Atlas", Paths.home(@locale)},
        {gettext("Stock exchanges"), Paths.markets(@locale)},
        {@e["short_name"], Paths.exchange(@locale, @e["code"])},
        {@row["name"], nil}
      ]}
      title={@row["name"]}
      tag={@row["ticker"]}
      kpis_id="security-kpis"
      class="security-head"
    >
      <:mark>
        <%= cond do %>
          <% @country -> %>
            <SyliAtlasWeb.UI.flag code={@country["code"]} size="lg" />
          <% match?([_], @e["countries"]) -> %>
            <SyliAtlasWeb.UI.flag code={hd(@e["countries"])} size="lg" />
          <% true -> %>
            <ProfileComponents.monogram text={@row["ticker"]} />
        <% end %>
      </:mark>
      <:actions>
        <SyliAtlasWeb.AccountComponents.follow
          kind="security"
          ref={@e["code"] <> "/" <> @row["ticker"]}
          locale={@locale}
          path={SyliAtlasWeb.Paths.security(@locale, @e["code"], @row["ticker"])}
          alert_market={{@e["code"], @row["ticker"]}}
        />
      </:actions>
      <:chips>
        <span class="pill pill-neutral no-dot">
          {if @row["kind"] == "etf", do: gettext("Exchange-traded fund"), else: gettext("Share")}
        </span>
        <a :if={@country} class="pill pill-neutral no-dot" href={country_href(@country, @locale)}>
          {SyliAtlas.Locales.pick(@country["name"], @locale)}
        </a>
        <a class="pill pill-neutral no-dot" href={Paths.exchange(@locale, @e["code"])}>
          {gettext("listed on the %{exchange}", exchange: @e["short_name"])}
        </a>
        <span :for={l <- @listings} class="pill pill-neutral no-dot mono" id={"listing-#{l["ticker"]}"}>
          {l["ticker"]} · {l["exchange"]}
        </span>
        <span :if={@sector} class="pill pill-neutral no-dot">{@sector}</span>
        <span
          :if={security_flag(@row)}
          class={[
            "pill no-dot",
            if(elem(security_flag(@row), 0) == :warn, do: "pill-warn", else: "pill-neutral")
          ]}
        >
          {elem(security_flag(@row), 1)}
        </span>
      </:chips>
      <:kpi id="close" label={gettext("Closing price")} value={price(@row["close"], @locale)}>
        {@row["currency"]}
        <span :if={
          usd(SyliAtlas.Market.to_usd(to_f(@row["close"]), @row["currency"], @fx), @locale)
        }>
          · {usd(SyliAtlas.Market.to_usd(to_f(@row["close"]), @row["currency"], @fx), @locale)}
        </span>
      </:kpi>
      <:kpi
        id="session"
        label={gettext("Session")}
        value={pct(@row["change_pct"], @locale)}
        tone={tone(@row["change_pct"])}
      >
        {day(@row["trade_date"], @locale)}
      </:kpi>
      <:kpi id="volume" label={gettext("Volume")} value={integer(@row["volume"], @locale)}>
        {gettext("securities traded")}
      </:kpi>
      <:kpi
        id="value"
        label={gettext("Value traded")}
        value={money_amount(@row["value"], @row["currency"], @locale)}
      >
        {usd(SyliAtlas.Market.to_usd(@row["value"], @row["currency"], @fx), @locale)}
      </:kpi>
      <:kpi
        id="share"
        label={gettext("Share of the exchange's trading")}
        value={if @share, do: number(@share, 0, @locale) <> " %", else: "—"}
      >
        {gettext("of the value traded that day")}
      </:kpi>
      <:kpi id="cap" label={gettext("Market capitalisation")} value="—">
        {gettext("not provided by the current source")}
      </:kpi>
    </ProfileComponents.entity_head>
  </.section>

  <.section class="tab-intro">
    <div class="stack gap-1">
      <p class="lead" data-answer>{@answer}</p>
      <p class="src">
        <.credit sources={@doc["sources"]} date={@row["trade_date"]} locale={@locale} />
      </p>
    </div>
  </.section>

  <.section id="security-stats">
    <div class="grid grid-2">
      <.card>
        <div class="pad">
          <.card_head
            title={gettext("What the sessions say")}
            subtitle={gettext("Syli Atlas calculations, from the closes it recorded")}
          />
        </div>
        <table class="table" id="security-stats-rows">
          <caption class="vh">{gettext("What the sessions say")}</caption>
          <tbody>
            <tr>
              <th scope="row" class="l">{gettext("Rank on the exchange by value traded")}</th>
              <td class="num">
                {if @stats["rank"],
                  do:
                    gettext("%{rank} of %{count}",
                      rank: @stats["rank"],
                      count: @stats["traded"]
                    ),
                  else: "—"}
              </td>
            </tr>
            <tr>
              <th scope="row" class="l">{gettext("Volume against the average of previous sessions")}</th>
              <td class="num">
                <%= if @stats["volume_ratio"] do %>
                  {number(@stats["volume_ratio"], 1, @locale)} ×
                <% else %>
                  <span class="muted small">
                    {gettext("from %{n} sessions", n: SyliAtlas.Market.SecurityStats.min_avg_sessions() + 1)}
                  </span>
                <% end %>
              </td>
            </tr>
            <tr>
              <th scope="row" class="l">
                {gettext("Since %{date}", date: day(@stats["first_date"], @locale))}
              </th>
              <td class="num">
                <%= if @stats["performance"] do %>
                  <span class={tone(@stats["performance"])}>{pct(@stats["performance"], @locale)}</span>
                  <span :if={@stats["index_performance"]} class="muted small">
                    · {gettext("index %{change}", change: pct(@stats["index_performance"], @locale))}
                  </span>
                <% else %>
                  —
                <% end %>
              </td>
            </tr>
            <tr :if={@stats["high"]}>
              <th scope="row" class="l">{gettext("Highest and lowest close since then")}</th>
              <td class="num">
                {price(@stats["high"], @locale)} / {price(@stats["low"], @locale)} {@row["currency"]}
              </td>
            </tr>
          </tbody>
        </table>
        <p class="pad small muted">
          {gettext("%{n} sessions recorded. 52-week figures come after a year of sessions.",
            n: @stats["sessions"]
          )}
          <a
            id="security-alert-suggest"
            href={
              Paths.account(@locale, :alerts) <>
                "?" <>
                URI.encode_query(%{
                  "exchange" => @e["code"],
                  "ticker" => @row["ticker"],
                  "kind" => "session_move",
                  "threshold" => "5"
                }) <> "#market-alert"
            }
          >
            {gettext("Get an email when %{ticker} moves 5 % or more in a session",
              ticker: @row["ticker"]
            )} →
          </a>
        </p>
      </.card>

      <.card :if={@context} pad class="stack gap-2" id="security-country">
        <p class="eyebrow">{gettext("The country of listing")}</p>
        <h2 class="h3">
          <a href={Paths.area(@locale, "country", @context.slug)}>{@context.name}</a>
        </h2>
        <table class="table">
          <caption class="vh">{@context.name}</caption>
          <tbody>
            <tr :for={a <- (@context.rating && @context.rating["agencies"]) || []}>
              <th scope="row" class="l">{SyliAtlasWeb.RatingComponents.agency_name(a["agency"])}</th>
              <td>
                <b class="num">{SyliAtlas.Ratings.Scale.display(a["rating"])}</b>
                <span class="muted small">{SyliAtlasWeb.RatingComponents.outlook_label(a["outlook"])}</span>
              </td>
            </tr>
            <tr :if={is_number(@context.growth)}>
              <th scope="row" class="l">
                {gettext("Real growth %{year}", year: @context.year)}
              </th>
              <td class="num">{number(@context.growth, 1, @locale)} %</td>
            </tr>
            <tr :if={is_number(@context.inflation)}>
              <th scope="row" class="l">{gettext("Inflation %{year}", year: @context.year)}</th>
              <td class="num">{number(@context.inflation, 1, @locale)} %</td>
            </tr>
            <tr :if={is_number(@context.debt)}>
              <th scope="row" class="l">{gettext("Public debt %{year}", year: @context.year)}</th>
              <td class="num">{number(@context.debt, 0, @locale)} % {gettext("of GDP")}</td>
            </tr>
          </tbody>
        </table>
        <p class="small muted">
          {gettext("IMF, World Economic Outlook")}<span :if={@context.status != "actual"}> · {gettext("estimate")}</span>
          · <a href={Paths.rating(@locale, @context.slug)}>{gettext("Sovereign rating")}</a>
        </p>
      </.card>
    </div>
  </.section>

  <.section>
    <.card pad>
      <.card_head
        title={gettext("Price history")}
        subtitle={
          gettext("Closes in %{currency} · sessions received by Syli Atlas",
            currency: @row["currency"]
          )
        }
      />
      <.index_chart
        :if={length(@history) >= 5}
        id="price-chart"
        history={@history}
        label={@answer}
        locale={@locale}
        name={@row["name"]}
        sources={@doc["sources"]}
      />
      <table :if={length(@sessions) in 1..4} class="table" id="price-sessions">
        <caption class="vh">{gettext("Closes recorded")}</caption>
        <thead>
          <tr>
            <th scope="col" class="l">{gettext("Session")}</th>
            <th scope="col">{gettext("Closing price")}</th>
            <th scope="col">{gettext("Change")}</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={s <- Enum.reverse(@sessions)}>
            <td class="l">{day(s["date"], @locale)}</td>
            <td class="num">{price(s["close"], @locale)} {@row["currency"]}</td>
            <td class={["num", tone(s["change_pct"])]}>{pct(s["change_pct"], @locale)}</td>
          </tr>
        </tbody>
      </table>
      <p :if={length(@sessions) in 1..4} class="small muted">
        {gettext("The chart appears from 5 sessions.")}
      </p>
      <div :if={@sessions == []} class="market-empty-chart" id="price-chart-empty">
        <p class="h3">{gettext("History being built")}</p>
        <p class="muted small">
          {gettext(
            "Every close is recorded from the first import on. Older history will come from an official or licensed source."
          )}
        </p>
      </div>
    </.card>

    <div class="grid grid-2">
      <.card>
        <div class="pad stack gap-2">
          <.card_head title={gettext("Security")} />
          <p :if={@about} id="security-about">{@about}</p>
        </div>
        <table class="table">
          <caption class="vh">{gettext("Security")} {@row["ticker"]}</caption>
          <tbody>
            <tr>
              <th scope="row" class="l">{gettext("Code")}</th><td class="mono">
                {@row["ticker"]}
              </td>
            </tr>
            <tr>
              <th scope="row" class="l">{gettext("Exchange")}</th>
              <td>
                <a href={Paths.exchange(@locale, @e["code"])}>{@e["short_name"]}</a>
                <span :if={@e["mic"]} class="mono small muted">{@e["mic"]}</span>
              </td>
            </tr>
            <tr :if={@country}>
              <th scope="row" class="l">{gettext("Country")}</th>
              <td>
                <a href={country_href(@country, @locale)}>{SyliAtlas.Locales.pick(
                  @country["name"],
                  @locale
                )}</a>
              </td>
            </tr>
            <tr>
              <th scope="row" class="l">{gettext("Currency")}</th><td class="mono">
                {@row["currency"]}
              </td>
            </tr>
            <tr :if={@row["issuer"]}>
              <th scope="row" class="l">{gettext("Issuer")}</th><td>{@row["issuer"]}</td>
            </tr>
            <tr :for={l <- @listings}>
              <th scope="row" class="l">{gettext("Also listed")}</th>
              <td>
                {l["exchange"]} · <span class="mono">{l["ticker"]}</span>
                <span :if={l["shares_per_receipt"]} class="muted small">
                  {gettext("1 receipt = %{n} shares", n: l["shares_per_receipt"])}
                </span>
              </td>
            </tr>
            <tr :if={@isin}>
              <th scope="row" class="l">ISIN</th><td class="mono">{@isin}</td>
            </tr>
          </tbody>
        </table>
      </.card>
      <.card pad class="stack gap-3">
        <p class="eyebrow">{gettext("Where these figures come from")}</p>
        <p>
          {gettext(
            "Price, change and volume: %{source}. Value traded and share of trading: computed by Syli Atlas.",
            source: SyliAtlas.Market.Catalog.name(@row["source"] || "mansa")
          )}
        </p>
        <.market_sources sources={@doc["sources"]} locale={@locale} />
        <p class="small muted">{gettext("Information, not investment advice.")}</p>
        <a class="market-more" href={Paths.exchange(@locale, @e["code"])}>{gettext(
          "The %{exchange} page",
          exchange: @e["short_name"]
        )} →</a>
      </.card>
    </div>
  </.section>

  <.section :if={@peers != []} id="security-peers">
    <.card>
      <div class="pad">
        <.card_head
          title={gettext("Comparable securities on the %{exchange}", exchange: @e["short_name"])}
          subtitle={@sector}
        />
      </div>
      <div class="table-box">
        <table class="table">
          <caption class="vh">
            {gettext("Comparable securities on the %{exchange}", exchange: @e["short_name"])}
          </caption>
          <thead>
            <tr>
              <th scope="col" class="l">{gettext("Security")}</th>
              <th scope="col">{gettext("Closing price")}</th>
              <th scope="col">{gettext("Session")}</th>
              <th scope="col">{gettext("Value traded")}</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={r <- [@row | @peers]} class={r["ticker"] == @row["ticker"] && "is-current"}>
              <td class="l">
                <%= if r["ticker"] == @row["ticker"] do %>
                  <b>{r["name"]}</b>
                <% else %>
                  <a href={Paths.security(@locale, @e["code"], r["ticker"])}>{r["name"]}</a>
                <% end %>
                <span class="mono small muted">{r["ticker"]}</span>
              </td>
              <td class="num">{price(r["close"], @locale)}</td>
              <td class={["num", tone(r["change_pct"])]}>{pct(r["change_pct"], @locale)}</td>
              <td class="num">{money_amount(r["value"], r["currency"], @locale)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pad small muted">
        <.credit sources={@doc["sources"]} date={@row["trade_date"]} locale={@locale} />
      </p>
    </.card>
  </.section>

  <.section :if={@faq != []} id="security-faq">
    <div class="stack gap-3">
      <h2 class="h2">{gettext("Questions")}</h2>
      <.faq items={@faq} />
    </div>
  </.section>
</Layouts.public>
