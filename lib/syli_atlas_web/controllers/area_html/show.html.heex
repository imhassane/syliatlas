<Layouts.public locale={@locale} alternates={@alternates}>
  <script type="application/json" id="area-data">
    {raw(embedded_json(@profile))}
  </script>

  <section class="section" style="padding-bottom: 32px">
    <div class="wrap stack gap-4">
      <nav class="crumbs small" aria-label={gettext("Breadcrumb")}>
        <a href={Paths.home(@locale)}>Syli Atlas</a>
        <span :if={@region}> / <a href={Paths.area(@locale, @region)}>{SyliAtlas.Geo.Area.name(
          @region,
          @locale
        )}</a></span>
      </nav>
      <div class="row between gap-4" style="align-items: flex-end">
        <div class="stack gap-2">
          <p class="eyebrow">{kind_label(@area.kind)} · {@area.code}</p>
          <h1 class="display" style="font-size: clamp(40px, 6vw, 72px)">{@name}</h1>
        </div>
        <.period_form action={Paths.area(@locale, @area)} from={@from} to={@to} />
      </div>
      <p class="lead" data-answer>{@answer}</p>
      <.source_line edition={@profile["edition"]} locale={@locale} />
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap stack gap-6">
      <dl class="stats" data-kpis>
        <div :for={k <- @kpis}>
          <dt>{indicator_label(k)}</dt>
          <%= if k == "real_gdp_index" do %>
            <dd class={["big", tone(@data["period"]["changes"][k], k)]} data-kpi={k}>
              {change(@data["period"]["changes"][k], k, @locale)}
            </dd>
            <dd class="small muted">{@from} → {@to}</dd>
          <% else %>
            <dd class="big" data-kpi={k}>
              {value(PublicData.at(@profile["series"][k], @to), k, @locale)}
            </dd>
            <dd class="small muted">
              {@to}
              <span class={["num", tone(@data["period"]["changes"][k], k)]}>· {change(
                @data["period"]["changes"][k],
                k,
                @locale
              )} {gettext("since %{year}", year: @from)}</span>
            </dd>
          <% end %>
        </div>
      </dl>

      <div class="card pad">
        <div class="row between gap-2">
          <div>
            <h2 class="h2">{indicator_label("real_gdp_index")}</h2>
            <p class="small muted">
              {gettext("Index, %{year} = 100 · dashed: estimates and projections", year: @from)}
            </p>
          </div>
        </div>
        <Charts.line_chart
          id="area-chart"
          indicator="real_gdp_index"
          from={@from}
          to={@to}
          locale={@locale}
          estimate_from={@profile["years"]["estimate_from"]}
          label={@answer}
          series={[
            %{
              id: @profile["code"],
              name: @name,
              color: "--c1",
              values: Charts.rebase(@profile["series"]["real_gdp_index"], @from),
              strong: true
            }
          ]}
        />
      </div>

      <div
        class="grid"
        style="grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); align-items: start"
      >
        <div class="card">
          <div class="pad" style="padding-bottom: 8px">
            <h2 class="h2">
              {if @area.kind == "country",
                do: gettext("In its region"),
                else: gettext("The five regions")}
            </h2>
            <p class="small muted">
              {gettext("Real GDP, %{from} → %{to}", from: @from, to: @to)}
            </p>
          </div>
          <ol class="rank-list">
            <li
              :for={{p, i} <- Enum.with_index(@peers, 1)}
              class={p["code"] == @area.code && "is-current"}
            >
              <span class="num subtle">{i}</span>
              <a href={
                Paths.with_period(
                  Paths.area(@locale, p["kind"] || "country", p["slug"]),
                  @from,
                  @to
                )
              }>{p["name"]}</a>
              <b class={["num", tone(p["value"], "real_gdp_index")]}>{change(
                p["value"],
                "real_gdp_index",
                @locale
              )}</b>
            </li>
          </ol>
        </div>

        <div class="card">
          <div class="pad" style="padding-bottom: 8px">
            <h2 class="h2">{gettext("All indicators")}</h2>
            <p class="small muted">
              {gettext("Value in %{to} and change since %{from}", from: @from, to: @to)}
            </p>
          </div>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col" style="padding-left: 24px">{gettext("Indicator")}</th>
                  <th scope="col">{@from}</th>
                  <th scope="col">{@to}</th>
                  <th scope="col" style="padding-right: 24px">{gettext("Change")}</th>
                </tr>
              </thead>
              <tbody>
                <tr :for={k <- SyliAtlas.Sources.Indicators.keys()}>
                  <td style="padding-left: 24px" title={indicator_help(k)}>
                    {indicator_label(k)}
                  </td>
                  <td>{value(PublicData.at(@profile["series"][k], @from), k, @locale)}</td>
                  <td>{value(PublicData.at(@profile["series"][k], @to), k, @locale)}</td>
                  <td style="padding-right: 24px" class={tone(@data["period"]["changes"][k], k)}>
                    {change(@data["period"]["changes"][k], k, @locale)}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="src pad" style="padding-top: 12px">
            <a href={"/api/v1/areas/#{@area.code}/csv"} download>{gettext("Download CSV")}</a>
            · <a href={"/api/v1/areas/#{@area.code}"}>JSON</a>
          </p>
        </div>
      </div>

      <div :if={@members != []} class="card">
        <div class="pad" style="padding-bottom: 8px">
          <h2 class="h2">{gettext("Member countries")}</h2>
          <p class="small muted">{gettext("Real GDP, %{from} → %{to}", from: @from, to: @to)}</p>
        </div>
        <div class="table-wrap">
          <table class="table">
            <tbody>
              <tr :for={m <- @members}>
                <td style="padding-left: 24px">
                  <a href={Paths.with_period(Paths.area(@locale, m), @from, @to)}>{m["label"]}</a>
                </td>
                <td
                  style="padding-right: 24px"
                  class={tone(m["real_gdp_change_pct"], "real_gdp_index")}
                >
                  {change(m["real_gdp_change_pct"], "real_gdp_index", @locale)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p :if={@profile["missing"] not in [nil, []]} class="src pad" style="padding-top: 12px">
          {gettext("Not included for lack of data: %{codes}",
            codes: Enum.join(List.wrap(@profile["missing"]), ", ")
          )}
        </p>
      </div>

      <div class="row gap-2">
        <a class="btn btn-primary" href={Paths.compare(@locale, [@profile["slug"][@locale]])}>{gettext(
          "Compare %{name}",
          name: @name
        )} →</a>
        <a class="btn btn-secondary" href={Paths.ranking(@locale)}>{gettext("African ranking")}</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div
      class="wrap grid"
      style="grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); align-items: start"
    >
      <div class="stack gap-4">
        <h2 class="h1">{gettext("Questions")}</h2>
        <details :for={{q, a} <- @faq} class="faq">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      </div>
      <div class="stack gap-4">
        <div class="card pad stack gap-2">
          <p class="eyebrow">{gettext("Discussion")}</p>
          <h2 class="h2">{gettext("A question, a correction, a source?")}</h2>
          <p class="muted">
            {gettext("Every profile has a moderated discussion. Sign in by email to take part.")}
          </p>
          <a class="btn btn-secondary" href={Paths.discussion(@locale, @area)} rel="nofollow">{gettext(
            "Open the discussion"
          )} →</a>
        </div>
        <div class="card pad stack gap-2">
          <p class="eyebrow">{gettext("Cite this page")}</p>
          <p class="small mono">
            {citation(
              @name,
              @profile["edition"],
              SyliAtlasWeb.Seo.url(Paths.area(@locale, @area))
            )}
          </p>
        </div>
      </div>
    </div>
  </section>
</Layouts.public>
