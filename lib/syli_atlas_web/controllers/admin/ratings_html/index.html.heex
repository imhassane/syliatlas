<main id="main" class="adm">
  <div class="wrap stack gap-4">
    <header class="adm-head">
      <div>
        <p class="eyebrow">Admin Syli Atlas</p>
        <h1 class="h1">Notations souveraines à valider</h1>
        <p class="small muted">
          Rien n'est publié sans validation humaine. La source publiée est toujours le communiqué de l'agence, jamais l'article ni l'IA.
        </p>
      </div>
      <.form for={%{}} action={~p"/admin/notations/veille"} method="post">
        <button class="btn btn-secondary" type="submit" id="adm-watch">Lancer la veille maintenant</button>
        <p class="small muted">
          IA : {if @extractor?,
            do: "clé configurée",
            else: "ANTHROPIC_API_KEY absente, la veille ne propose rien"}
          <span :if={@last_watch}>· dernière veille : {Calendar.strftime(
            @last_watch,
            "%d/%m/%Y %H:%M"
          )} UTC</span>
        </p>
      </.form>
    </header>

    <p :if={msg = Phoenix.Flash.get(@flash, :info)} class="adm-flash ok" role="status">{msg}</p>
    <p :if={msg = Phoenix.Flash.get(@flash, :error)} class="adm-flash err" role="alert">{msg}</p>

    <section class="stack gap-3" id="adm-pending">
      <h2 class="h2">File d'attente <span class="muted num">{length(@pending)}</span></h2>
      <p :if={@pending == []} class="muted">Aucune proposition en attente.</p>

      <article :for={p <- @pending} class="card pad stack gap-2 adm-item" id={"proposal-#{p.id}"}>
        <div class="adm-item-head">
          <b>{country_name(@doc, p.country_code)}</b>
          <span class="mono">{agency_name(p.agency)} · {display(p.rating)}</span>
          <span class="small muted">{origin_label(p.origin)} · {Calendar.strftime(
            p.inserted_at,
            "%d/%m %H:%M"
          )}</span>
        </div>
        <p :if={cur = current(@doc, p.country_code, p.agency)} class="small muted">
          En ligne : {display(cur["rating"])}, {outlook_label(cur["outlook"])} ({cur[
            "action_date"
          ]})
        </p>
        <ul :if={p.warnings != []} class="adm-warn">
          <li :for={w <- p.warnings}>⚠ {warning_label(w)}</li>
        </ul>
        <blockquote :if={p.excerpt} class="adm-quote">
          « {p.excerpt} »
          <footer :if={p.article_url} class="small">
            <a href={p.article_url} rel="noopener noreferrer" target="_blank">{p.article_title ||
              p.article_url} ↗</a>
          </footer>
        </blockquote>

        <.form
          for={%{}}
          action={~p"/admin/notations/#{p.id}/approuver"}
          method="post"
          class="adm-form"
        >
          <.adm_fields proposal={p} doc={@doc} />
          <div class="adm-actions">
            <button class="btn btn-primary" type="submit">Publier</button>
          </div>
        </.form>
        <.form for={%{}} action={~p"/admin/notations/#{p.id}/rejeter"} method="post">
          <button class="btn btn-ghost small" type="submit">Rejeter</button>
        </.form>
      </article>
    </section>

    <section class="card pad stack gap-2" id="adm-new">
      <h2 class="h2">Saisir une décision</h2>
      <p class="small muted">Elle rejoint la file d'attente, puis se publie comme les autres.</p>
      <.form for={%{}} action={~p"/admin/notations"} method="post" class="adm-form">
        <.adm_fields proposal={%SyliAtlas.Ratings.Proposal{}} doc={@doc} />
        <div class="adm-actions">
          <button class="btn btn-secondary" type="submit">Ajouter à la file</button>
        </div>
      </.form>
    </section>

    <section class="stack gap-3" id="adm-check">
      <h2 class="h2">
        Notes en ligne marquées « à vérifier » <span class="muted num">{length(@to_check)}</span>
      </h2>
      <p class="small muted">
        Comparer au communiqué de l'agence, corriger si besoin, coller le lien du communiqué, puis valider.
      </p>
      <article :for={r <- @to_check} class="card pad stack gap-2" id={"check-#{r.id}"}>
        <div class="adm-item-head">
          <b>{country_name(@doc, r.country_code)}</b>
          <span class="mono">{agency_name(r.agency)} · {display(r.rating)} · {outlook_label(
            r.outlook
          )} · {r.action_date}</span>
        </div>
        <p :if={r.note} class="small muted">{r.note}</p>
        <p :if={r.source_url} class="small">
          Source actuelle :
          <a href={r.source_url} rel="noopener noreferrer" target="_blank">{r.source_url}</a>
        </p>
        <.form
          for={%{}}
          action={~p"/admin/notations/verifier/#{r.id}"}
          method="post"
          class="adm-form"
        >
          <label>Note <input name="r[rating]" value={r.rating} /></label>
          <label>
            Perspective
            <select name="r[outlook]">
              <option :for={{l, v} <- outlooks()} value={v} selected={v == (r.outlook || "")}>
                {l}
              </option>
            </select>
          </label>
          <label>Date
          <input name="r[action_date]" value={r.action_date} placeholder="AAAA-MM-JJ" /></label>
          <label class="adm-wide">Communiqué de l'agence
          <input name="r[source_url]" type="url" placeholder="https://…" /></label>
          <div class="adm-actions">
            <button class="btn btn-secondary" type="submit">Marquer vérifiée</button>
          </div>
        </.form>
      </article>
    </section>

    <section :if={@decided != []} class="stack gap-2" id="adm-decided">
      <h2 class="h2">Dernières décisions de la file</h2>
      <table class="table">
        <thead>
          <tr>
            <th class="l">Pays</th><th class="l">Agence</th><th class="l">Note</th><th class="l">
              Statut
            </th><th class="l">Le</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={p <- Enum.sort_by(@decided, & &1.reviewed_at, {:desc, DateTime})}>
            <td class="l">{country_name(@doc, p.country_code)}</td>
            <td class="l">{agency_name(p.agency)}</td>
            <td class="l">{display(p.rating)}</td>
            <td class="l">{status_label(p.status)}</td>
            <td class="l">{p.reviewed_at && Calendar.strftime(p.reviewed_at, "%d/%m/%Y")}</td>
          </tr>
        </tbody>
      </table>
    </section>
  </div>
</main>
