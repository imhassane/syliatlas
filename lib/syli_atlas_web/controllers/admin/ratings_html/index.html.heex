<.admin_shell
  current={:ratings}
  counts={@admin_counts}
  until={@admin_until}
  key={@admin_key}
>
  <input type="checkbox" id="adm-new-toggle" class="adm-toggle" hidden />
  <header class="adm-head">
    <div class="adm-intro">
      <p class="eyebrow">Données</p>
      <h1 class="adm-title">Notations à valider</h1>
      <p class="muted">
        La veille quotidienne lit l'actualité, l'IA propose une décision d'agence avec l'extrait qui la justifie. Rien n'est publié avant validation sur le communiqué de l'agence.
      </p>
    </div>
    <div class="adm-head-actions">
      <.form for={%{}} action={~p"/admin/notations/veille"} method="post" id="adm-watch-form">
        <button class="btn btn-secondary" type="submit" id="adm-watch">Lancer la veille</button>
      </.form>
      <label for="adm-new-toggle" class="btn btn-primary" id="adm-new-open" role="button">
        Saisir une notation
      </label>
    </div>
  </header>

  <p :if={msg = Phoenix.Flash.get(@flash, :info)} class="adm-flash ok" role="status">{msg}</p>
  <p :if={msg = Phoenix.Flash.get(@flash, :error)} class="adm-flash err" role="alert">{msg}</p>

  <dl class="stats" id="adm-stats">
    <div>
      <dt>À valider</dt>
      <dd class="big num">{length(@pending)}</dd>
      <dd class="small muted">propositions dans la file</dd>
    </div>
    <div>
      <dt>Dernière veille</dt>
      <dd class="big num adm-big-sm">
        {if @last_watch, do: Calendar.strftime(@last_watch, "%H:%M") <> " UTC", else: "—"}
      </dd>
      <dd class="small muted">
        {if @last_watch, do: fr_date(@last_watch), else: "jamais lancée"} · {if @extractor?,
          do: "IA configurée",
          else: "IA absente (ANTHROPIC_API_KEY)"}
      </dd>
    </div>
    <div>
      <dt>Lignes à vérifier</dt>
      <dd class="big num">{length(@to_check)}</dd>
      <dd class="small muted">notes en ligne à comparer au communiqué</dd>
    </div>
    <div>
      <dt>Pays notés</dt>
      <dd class="big num">{rated_count(@doc)}</dd>
      <dd class="small muted">sur 54, au moins une agence</dd>
    </div>
  </dl>

  <section class="card adm-new" id="adm-new">
    <div class="adm-card-head">
      <div>
        <h2 class="h2">Saisir une notation</h2>
        <p class="small muted">
          Elle rejoint la file d'attente, puis se publie comme les autres.
        </p>
      </div>
      <label for="adm-new-toggle" class="btn btn-quiet btn-sm" role="button">Fermer</label>
    </div>
    <.form for={%{}} action={~p"/admin/notations"} method="post" class="adm-form adm-pad">
      <.adm_fields proposal={%SyliAtlas.Ratings.Proposal{}} doc={@doc} />
      <div class="adm-actions">
        <button class="btn btn-primary" type="submit">Ajouter à la file</button>
      </div>
    </.form>
  </section>

  <section class="card adm-list" id="adm-pending">
    <div class="adm-card-head">
      <h2 class="h2">File d'attente</h2>
      <nav class="adm-filters" aria-label="Filtrer la file">
        <a
          :for={
            {key, label} <- [
              {"toutes", "Toutes"},
              {"changements", "Changements de note"},
              {"confirmations", "Confirmations"}
            ]
          }
          href={
            if(key == "toutes",
              do: ~p"/admin/notations",
              else: ~p"/admin/notations?filtre=#{key}"
            )
          }
          class={["btn btn-sm", if(key == @filter, do: "btn-primary", else: "btn-secondary")]}
          aria-current={if(key == @filter, do: "page")}
          id={"adm-filter-#{key}"}
        >
          {label}
        </a>
      </nav>
    </div>

    <p :if={@shown.total == 0} class="adm-empty muted" id="adm-empty">
      {if @pending == [],
        do: "File vide. La prochaine veille passe demain à 07:20 UTC.",
        else: "Aucune proposition de ce type dans la file."}
    </p>

    <%= for p <- @shown.entries do %>
      <% {pill, pill_class} = decision_pill(p, @doc) %>
      <% cur = current(@doc, p.country_code, p.agency) %>
      <.form
        for={%{}}
        action={~p"/admin/notations/#{p.id}/approuver"}
        method="post"
        class="adm-row"
        id={"proposal-#{p.id}"}
      >
        <input
          type="checkbox"
          id={"fix-#{p.id}"}
          class="adm-toggle"
          hidden
          checked={"unknown_country" in (p.warnings || [])}
        />
        <div class="adm-row-main">
          <div class="adm-item-head">
            <b>{country_name(@doc, p.country_code)} · {agency_name(p.agency)}</b>
            <span class={["pill", pill_class]}>{pill}</span>
            <span class="mono subtle small">
              {if(p.origin == "watch", do: "détectée", else: "saisie")} le {fr_date(p.inserted_at)} · {origin_label(
                p.origin
              )}
            </span>
          </div>
          <p class="adm-proposal">
            Proposition : <b class="num">{proposal_text(p, cur)}</b>, {outlook_label(p.outlook)}, {fr_date(
              p.action_date
            )}
          </p>
          <p :if={cur} class="small muted">
            En ligne : {display(cur["rating"])}, {outlook_label(cur["outlook"])}, {fr_date(
              cur["action_date"]
            )}
          </p>
          <blockquote :if={p.excerpt} class="adm-quote">
            Extrait retenu par l'IA : « {p.excerpt} »
            <a
              :if={p.article_url}
              href={p.article_url}
              rel="noopener noreferrer"
              target="_blank"
            >
              · {p.article_title || URI.parse(p.article_url).host} ↗
            </a>
          </blockquote>
          <p class="adm-checks mono small">
            Contrôles :
            <%= for {{ok?, label}, i} <- Enum.with_index(checks(p)) do %>
              {if i > 0, do: " · "}<span class={if(ok?, do: "subtle", else: "adm-bad")}>{label} {if ok?,
                do: "✓",
                else: "⚠"}</span>
            <% end %>
          </p>
        </div>
        <div class="adm-row-side">
          <label class="adm-field">
            Lien du communiqué de l'agence
            <input
              name="p[source_url]"
              type="url"
              value={p.source_url}
              placeholder={source_placeholder(p.agency)}
            />
          </label>
          <div class="adm-buttons">
            <button class="btn btn-primary btn-sm" type="submit" id={"approve-#{p.id}"}>
              Valider et publier
            </button>
            <label for={"fix-#{p.id}"} class="btn btn-secondary btn-sm" role="button">
              Corriger
            </label>
            <button
              class="btn btn-quiet btn-sm"
              type="submit"
              form={"reject-#{p.id}"}
              id={"reject-btn-#{p.id}"}
            >
              Rejeter
            </button>
          </div>
        </div>
        <div class="adm-fix adm-form">
          <.adm_fields proposal={p} doc={@doc} source={false} />
        </div>
      </.form>
      <.form
        for={%{}}
        action={~p"/admin/notations/#{p.id}/rejeter"}
        method="post"
        id={"reject-#{p.id}"}
        class="adm-hidden-form"
      >
      </.form>
    <% end %>
    <.admin_pager page={@shown} path={~p"/admin/notations"} params={@params} />
  </section>

  <section class="card adm-list" id="adm-check">
    <div class="adm-card-head">
      <div>
        <h2 class="h2">
          Notes en ligne à vérifier <span class="muted num">{length(@to_check)}</span>
        </h2>
        <p class="small muted">
          Comparer au communiqué de l'agence, corriger si besoin, coller le lien du communiqué, puis valider.
        </p>
      </div>
    </div>
    <p :if={@to_check_page.total == 0} class="adm-empty muted">Aucune note à vérifier.</p>

    <.form
      :for={r <- @to_check_page.entries}
      for={%{}}
      action={~p"/admin/notations/verifier/#{r.id}"}
      method="post"
      class="adm-row"
      id={"check-#{r.id}"}
    >
      <input type="checkbox" id={"fix-check-#{r.id}"} class="adm-toggle" hidden />
      <div class="adm-row-main">
        <div class="adm-item-head">
          <b>{country_name(@doc, r.country_code)} · {agency_name(r.agency)}</b>
          <span class="pill pill-warn">À vérifier</span>
        </div>
        <p class="adm-proposal">
          En ligne : <b class="num">{display(r.rating)}</b>, {outlook_label(r.outlook)}, {fr_date(
            r.action_date
          )}
        </p>
        <p :if={r.note} class="small muted">{r.note}</p>
        <p :if={r.source_url} class="small adm-source">
          Source actuelle :
          <a href={r.source_url} rel="noopener noreferrer" target="_blank">{r.source_url}</a>
        </p>
      </div>
      <div class="adm-row-side">
        <label class="adm-field">
          Lien du communiqué de l'agence
          <input name="r[source_url]" type="url" placeholder={source_placeholder(r.agency)} />
        </label>
        <div class="adm-buttons">
          <button class="btn btn-primary btn-sm" type="submit">Marquer vérifiée</button>
          <label for={"fix-check-#{r.id}"} class="btn btn-secondary btn-sm" role="button">
            Corriger
          </label>
        </div>
      </div>
      <div class="adm-fix adm-form">
        <label>Note <input name="r[rating]" value={r.rating} /></label>
        <label>
          Perspective
          <select name="r[outlook]">
            <option :for={{l, v} <- outlooks()} value={v} selected={v == (r.outlook || "")}>
              {l}
            </option>
          </select>
        </label>
        <label>
          Date <input name="r[action_date]" value={r.action_date} placeholder="AAAA-MM-JJ" />
        </label>
      </div>
    </.form>
    <.admin_pager page={@to_check_page} path={~p"/admin/notations"} params={@params} key="verif" />
  </section>

  <section :if={@decided.total > 0} class="card adm-list" id="adm-decided">
    <div class="adm-card-head">
      <h2 class="h2">Dernières décisions de la file</h2>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th class="l">Pays</th>
          <th class="l">Agence</th>
          <th class="l">Note</th>
          <th class="l">Statut</th>
          <th class="l">Le</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={p <- @decided.entries}>
          <td class="l">{country_name(@doc, p.country_code)}</td>
          <td class="l">{agency_name(p.agency)}</td>
          <td class="l">{display(p.rating)}</td>
          <td class="l">{status_label(p.status)}</td>
          <td class="l">{fr_date(p.reviewed_at)}</td>
        </tr>
      </tbody>
    </table>
    <.admin_pager page={@decided} path={~p"/admin/notations"} params={@params} key="decisions" />
  </section>

  <p class="mono subtle small">
    La source publiée est toujours le communiqué de l'agence (spglobal.com, moodys.com, fitchratings.com), jamais l'article ni l'IA.
  </p>
</.admin_shell>
