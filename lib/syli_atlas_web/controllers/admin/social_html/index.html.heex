<.admin_shell current={:social} counts={@admin_counts} until={@admin_until} key={@admin_key}>
  <header class="adm-head">
    <div class="adm-intro">
      <p class="eyebrow">Site</p>
      <h1 class="adm-title">Réseaux</h1>
      <p class="muted">
        Chaque événement validé (notation, loi de finances, édition du FMI, rebasage) prépare un post pour X en anglais et un pour LinkedIn en français. Rien ne part avant validation.
      </p>
    </div>
  </header>

  <section class="card soc-service" id="social-service">
    <%= if @stats.simulated do %>
      <span class="pill pill-warn">Buffer simulé</span>
      <span class="muted">
        Pas de clé Buffer sur ce serveur : les posts validés sont marqués « simulé », rien n'est envoyé.
      </span>
    <% else %>
      <span class="pill pill-ok">Buffer connecté</span>
      <span class="muted">
        <%= case @channels do %>
          <% {:ok, []} -> %>
            Aucun compte connecté dans Buffer.
          <% {:ok, list} -> %>
            {Enum.map_join(list, " · ", &"#{service_name(&1.service)} : #{&1.name}")}
          <% {:error, message} -> %>
            Comptes illisibles : {message}
        <% end %>
      </span>
    <% end %>
    <span class="mono subtle small">Ajout à la file Buffer : l'heure suit son planning</span>
  </section>

  <dl class="stats" id="social-stats">
    <div>
      <dt>À valider</dt>
      <dd class="big num adm-big-sm">{@stats.drafts}</dd>
      <dd class="small muted">brouillons préparés</dd>
    </div>
    <div>
      <dt>Envoyés · 7 jours</dt>
      <dd class="big num adm-big-sm">{@stats.sent}</dd>
      <dd class="small muted">
        {if @stats.simulated, do: "simulés sur ce serveur", else: "X et LinkedIn"}
      </dd>
    </div>
    <div>
      <dt>Échecs · 7 jours</dt>
      <dd class="big num adm-big-sm">{@stats.failed}</dd>
      <dd class={["small", if(@stats.failed > 0, do: "down", else: "muted")]}>
        nouvel essai automatique, 5 au plus
      </dd>
    </div>
  </dl>

  <section class="card adm-list" id="social-drafts">
    <div class="adm-card-head">
      <h2 class="h2">Brouillons</h2>
      <span class="mono subtle small">les plus importants d'abord</span>
    </div>
    <p :if={@drafts == []} class="adm-empty muted" id="social-empty">
      Aucun brouillon. Le prochain arrivera avec le prochain événement validé.
    </p>

    <%= for p <- @drafts do %>
      <.form
        for={%{}}
        action={~p"/admin/reseaux/#{p.id}/valider"}
        method="post"
        class="soc-row"
        id={"post-#{p.id}"}
      >
        <div class="adm-item-head">
          <b>{title(p)}</b>
          <span class="pill pill-info">{kind_label(p.kind)}</span>
          <span class="mono subtle small">préparé le {fr_datetime(p.inserted_at)}</span>
        </div>
        <div class="soc-pair">
          <section class="soc-col" aria-label="Post X">
            <label class="adm-field" for={"post-#{p.id}-x"}>
              <span>
                X · anglais
                <span
                  class={["mono", if(x_count(p) > x_limit(), do: "adm-bad", else: "subtle")]}
                  data-x-count={"post-#{p.id}-x"}
                >
                  {x_count(p)} / {x_limit()}
                </span>
              </span>
              <textarea
                id={"post-#{p.id}-x"}
                name="post[text_x]"
                rows="6"
                data-social-text="x"
                data-preview={"preview-x-#{p.id}"}
                data-link-length={if(p.link_x, do: "24", else: "0")}
              >{p.text_x}</textarea>
            </label>
            <article class="soc-x" id={"preview-x-#{p.id}"} aria-label="Aperçu du post sur X">
              <img
                class="soc-x-avatar"
                src={~p"/images/icon-192.png"}
                alt=""
                width="40"
                height="40"
              />
              <div class="soc-x-main">
                <div class="soc-x-head">
                  <b>Syli Atlas</b>
                  <span class="soc-x-muted">@syliatlas · programmé</span>
                </div>
                <div class="soc-x-text">
                  <span data-preview-text>{p.text_x}</span><span :if={p.link_x}>
                    <span class="soc-x-link">{x_display_link(p.link_x)}</span>
                  </span>
                </div>
                <img
                  :if={p.image_url}
                  class="soc-x-image"
                  src={Post.x_image(p)}
                  alt=""
                  loading="lazy"
                  width="1200"
                  height="630"
                />
                <div class="soc-x-actions" aria-hidden="true">
                  <.social_action icon={:reply} />
                  <.social_action icon={:repost} />
                  <.social_action icon={:like} />
                  <.social_action icon={:views} />
                </div>
              </div>
            </article>
          </section>

          <section class="soc-col" aria-label="Post LinkedIn">
            <label class="adm-field" for={"post-#{p.id}-li"}>
              <span>LinkedIn · français</span>
              <textarea
                id={"post-#{p.id}-li"}
                name="post[text_linkedin]"
                rows="6"
                data-social-text="linkedin"
                data-preview={"preview-li-#{p.id}"}
              >{p.text_linkedin}</textarea>
            </label>
            <article
              class="soc-li"
              id={"preview-li-#{p.id}"}
              aria-label="Aperçu du post sur LinkedIn"
            >
              <div class="soc-li-head">
                <img
                  class="soc-li-avatar"
                  src={~p"/images/icon-192.png"}
                  alt=""
                  width="48"
                  height="48"
                />
                <div>
                  <b>Syli Atlas</b>
                  <div class="soc-li-muted">Page · programmé</div>
                </div>
              </div>
              <div class="soc-li-body">
                <div class="soc-li-text" data-clamp>
                  <span data-preview-text>{linkedin_text(p)}</span><span :if={p.link_linkedin}>
                    <span class="soc-li-link">{p.link_linkedin}</span>
                  </span>
                </div>
                <button type="button" class="soc-li-more" data-more hidden>… voir plus</button>
              </div>
              <img
                :if={p.image_url}
                class="soc-li-image"
                src={p.image_url}
                alt=""
                loading="lazy"
                width="1200"
                height="630"
              />
              <div class="soc-li-actions" aria-hidden="true">
                <span>J'aime</span><span>Commenter</span><span>Republier</span><span>Envoyer</span>
              </div>
            </article>
          </section>
        </div>
        <div class="adm-buttons">
          <button class="btn btn-primary btn-sm" type="submit" id={"approve-#{p.id}"}>
            Valider et programmer
          </button>
          <button
            class="btn btn-secondary btn-sm"
            type="submit"
            name="reseaux"
            value="x"
            id={"approve-x-#{p.id}"}
          >
            Seulement X
          </button>
          <button
            class="btn btn-secondary btn-sm"
            type="submit"
            name="reseaux"
            value="linkedin"
            id={"approve-li-#{p.id}"}
          >
            Seulement LinkedIn
          </button>
          <button
            class="btn btn-secondary btn-sm"
            type="submit"
            formaction={~p"/admin/reseaux/#{p.id}"}
            id={"save-#{p.id}"}
          >
            Enregistrer sans valider
          </button>
          <button
            class="btn btn-quiet btn-sm"
            type="submit"
            form={"reject-#{p.id}"}
            id={"reject-btn-#{p.id}"}
          >
            Rejeter
          </button>
        </div>
      </.form>
      <.form
        for={%{}}
        action={~p"/admin/reseaux/#{p.id}/rejeter"}
        method="post"
        id={"reject-#{p.id}"}
        class="adm-hidden-form"
      >
      </.form>
    <% end %>
  </section>

  <section :if={@candidates != []} class="card adm-list" id="social-candidates">
    <div class="adm-card-head">
      <div>
        <h2 class="h2">Décisions récentes sans post</h2>
        <p class="small muted">
          Changements de note ou de perspective des 60 derniers jours, arrivés avant les posts ou vérifiés à la main.
        </p>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table adm-table">
        <tbody>
          <tr :for={r <- @candidates} id={"candidate-#{r.id}"}>
            <td class="l">{area_name(r.country_code)} · {agency_name(r.agency)}</td>
            <td class="l num">
              {r.rating}{if r.outlook not in [nil, "none"], do: ", #{r.outlook}"}
            </td>
            <td class="subtle">{r.action_date}</td>
            <td>
              <.form for={%{}} action={~p"/admin/reseaux/preparer/notation/#{r.id}"} method="post">
                <button class="btn btn-secondary btn-sm" type="submit" id={"prepare-#{r.id}"}>
                  Préparer le post
                </button>
              </.form>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card adm-list" id="social-history">
    <div class="adm-card-head">
      <h2 class="h2">Historique</h2>
    </div>
    <p :if={@history == []} class="adm-empty muted">Rien pour l'instant.</p>
    <div :if={@history != []} class="table-wrap">
      <table class="table adm-table">
        <thead>
          <tr>
            <th class="l">Post</th>
            <th class="l">X</th>
            <th class="l">LinkedIn</th>
            <th class="l">État</th>
            <th>Décidé</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={p <- @history} id={"history-#{p.id}"}>
            <td class="l adm-wrap">
              {title(p)}
              <div class="small muted">{String.slice(p.text_x, 0, 90)}…</div>
            </td>
            <%= for {network, name, state, error} <- [
                  {"x", "X", p.x_state, p.x_error},
                  {"linkedin", "LinkedIn", p.linkedin_state, p.linkedin_error}
                ] do %>
              <td class="l">
                <%= case network_state(state) do %>
                  <% nil -> %>
                    <span class="subtle">—</span>
                  <% {label, cls} -> %>
                    <div class="soc-cell">
                      <span class={["pill", cls]}>{label}</span>
                      <button
                        :if={error}
                        type="button"
                        class="soc-alert"
                        popovertarget={"error-#{p.id}-#{network}"}
                        aria-label={"Voir l'erreur d'envoi sur #{name}"}
                        id={"error-btn-#{p.id}-#{network}"}
                      >
                        <svg
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4" /><path d="M12 17.5v.01" />
                        </svg>
                      </button>
                      <.form
                        :if={
                          p.status in ["approved", "done"] and
                            state in ["queued", "simulated", "failed"]
                        }
                        for={%{}}
                        action={~p"/admin/reseaux/#{p.id}/renvoyer/#{network}"}
                        method="post"
                      >
                        <button
                          class="btn btn-quiet btn-sm"
                          type="submit"
                          id={"resend-#{p.id}-#{network}"}
                          aria-label={"Renvoyer sur #{name}"}
                        >
                          Renvoyer
                        </button>
                      </.form>
                    </div>
                    <div
                      :if={error}
                      popover
                      id={"error-#{p.id}-#{network}"}
                      class="soc-pop"
                      role="dialog"
                      aria-label={"Erreur d'envoi sur #{name}"}
                    >
                      <h3 class="h3">Erreur d'envoi sur {name}</h3>
                      <p class="small">{error}</p>
                      <p class="small muted">
                        « Renvoyer » relance l'envoi sur ce réseau une fois la cause corrigée.
                      </p>
                      <button
                        type="button"
                        class="btn btn-secondary btn-sm"
                        popovertarget={"error-#{p.id}-#{network}"}
                        popovertargetaction="hide"
                      >
                        Fermer
                      </button>
                    </div>
                <% end %>
              </td>
            <% end %>
            <td class="l">
              <% {label, cls} = status_label(p.status) %>
              <span class={["pill", cls]}>{label}</span>
            </td>
            <td class="subtle">
              {fr_datetime(p.reviewed_at)}
              <div :if={p.reviewed_by} class="small">{p.reviewed_by}</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</.admin_shell>
