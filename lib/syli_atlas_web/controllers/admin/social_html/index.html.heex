<.admin_shell current={:social} counts={@admin_counts} until={@admin_until} key={@admin_key}>
  <header class="adm-head">
    <div class="adm-intro">
      <p class="eyebrow">Site</p>
      <h1 class="adm-title">Réseaux</h1>
      <p class="muted">
        Les événements validés préparent leurs posts ; n'importe quelle page du site se partage depuis sa barre d'admin ou ici. X en anglais, LinkedIn en français. Rien ne part avant validation.
      </p>
    </div>
    <form
      class="soc-share-field"
      action={~p"/admin/reseaux/partager"}
      method="get"
      id="share-form"
    >
      <label for="share-page">Partager une page du site</label>
      <div>
        <input
          type="text"
          id="share-page"
          name="page"
          placeholder="https://syliatlas.com/fr/…"
          required
        />
        <button class="btn btn-primary btn-sm" type="submit" id="share-go">Préparer</button>
      </div>
    </form>
  </header>

  <section class="card soc-buffer" id="social-service" aria-label="Buffer">
    <div class="soc-buffer-part" id="social-accounts">
      <span class="soc-tag">Buffer · comptes</span>
      <%= if @stats.simulated do %>
        <span class="pill pill-warn">Buffer simulé</span>
        <p class="small muted">
          Pas de clé Buffer sur ce serveur : les posts validés sont marqués « simulé », rien n'est envoyé.
        </p>
      <% else %>
        <%= case @channels do %>
          <% {:ok, []} -> %>
            <span class="pill pill-warn">Aucun compte connecté dans Buffer</span>
          <% {:ok, list} -> %>
            <ul class="soc-accounts">
              <li :for={c <- list}>
                <.network_mark network={if(c.service == "twitter", do: "x", else: "linkedin")} />
                <b>{c.name}</b>
                <span class="soc-ok">connecté</span>
              </li>
            </ul>
          <% {:error, message} -> %>
            <span class="pill pill-warn">Comptes illisibles</span>
            <p class="small muted">{message}</p>
        <% end %>
      <% end %>
      <span class="mono subtle small">offre gratuite · {@quota.limit} posts programmés par réseau</span>
    </div>

    <div class="soc-buffer-part" id="social-quota">
      <span class="soc-tag">Programmés dans Buffer</span>
      <%= for {n, label} <- [{:x, "X"}, {:linkedin, "LinkedIn"}] do %>
        <div class="soc-quota" id={"quota-#{n}"}>
          <span>{label}</span>
          <i><b style={"width: #{quota_pct(Map.fetch!(@quota, n), @quota.limit)}"}></b></i>
          <span class="mono">{Map.fetch!(@quota, n)} / {@quota.limit}</span>
        </div>
      <% end %>
      <p :if={@full != []} class="small adm-bad">
        File pleine sur {Enum.map_join(@full, " et ", &network_name/1)} : « Programmer » attend qu'un post parte ; « En file » reste possible.
      </p>
      <p class="small muted">
        Prochain créneau libre : <b class="adm-strong">{@next_slot || "—"}</b>
        · En file : {@stats.ready} · Échecs : {@stats.failed}
      </p>
    </div>

    <div class="soc-buffer-part soc-buffer-week" id="social-week">
      <span class="soc-tag">Créneaux de la semaine · heure de Paris</span>
      <div
        class="soc-week"
        role="table"
        aria-label="Créneaux Buffer de la semaine"
        style={"grid-template-columns: 48px repeat(#{length(@week.days)}, minmax(0, 1fr))"}
      >
        <div role="row" class="soc-week-row">
          <span role="columnheader"></span>
          <span :for={d <- @week.days} role="columnheader" class="soc-week-day">{day_label(d)}</span>
        </div>
        <div :for={t <- @week.times} role="row" class="soc-week-row">
          <span role="rowheader" class="soc-week-time mono">{t}</span>
          <%= for d <- @week.days do %>
            <% cell = @week.cells[{d, t}] %>
            <span
              role="cell"
              class={["soc-week-cell", "is-#{cell.kind}"]}
              id={"slot-#{d}-#{String.replace(t, ":", "")}"}
            >
              {cell_text(cell) || if(cell.kind == :free, do: "libre")}
            </span>
          <% end %>
        </div>
      </div>
      <span class="small muted">Les horaires se règlent dans Buffer.</span>
    </div>

    <div class="soc-buffer-foot">
      <span class={["soc-sync", sync_ok?(@last_sync) && "is-ok"]} id="social-sync">
        {if @stats.simulated, do: "simulé : rien à synchroniser", else: sync_label(@last_sync)}
      </span>
      <.form
        :if={!@stats.simulated}
        for={%{}}
        action={~p"/admin/reseaux/synchroniser"}
        method="post"
      >
        <button class="btn btn-quiet btn-sm" type="submit" id="social-sync-now">Actualiser</button>
      </.form>
      <a class="btn btn-secondary btn-sm" href="https://publish.buffer.com" rel="noopener">
        Ouvrir Buffer ↗
      </a>
    </div>
  </section>

  <div class="soc-board" id="social-board">
    <section class="soc-column" id="social-drafts" aria-labelledby="col-drafts">
      <h2 class="soc-col-head" id="col-drafts">
        À valider <span class="mono subtle">{length(@board.drafts)}</span>
      </h2>
      <p class="small muted">Préparés par le site · rien n'est encore dans Buffer.</p>
      <p :if={@board.drafts == []} class="soc-empty muted" id="social-empty">
        Aucun brouillon. Le prochain arrivera avec le prochain événement validé.
      </p>
      <article :for={p <- @board.drafts} class="soc-card" id={"post-#{p.id}"}>
        <span class="soc-tag">{kind_label(p.kind)} · {fr_datetime(p.inserted_at)}</span>
        <b>{title(p)}</b>
        <p class="soc-card-text small muted">{String.slice(p.text_x, 0, 140)}</p>
        <span class="soc-nets">
          <.network_mark :for={n <- networks_of(p)} network={n} />
        </span>
        <div class="soc-card-actions">
          <.form for={%{}} action={~p"/admin/reseaux/#{p.id}/valider"} method="post">
            <button
              class="btn btn-primary btn-sm"
              type="submit"
              id={"approve-#{p.id}"}
              disabled={Enum.any?(networks_of(p), &(&1 in @full))}
            >
              Programmer
            </button>
          </.form>
          <.form for={%{}} action={~p"/admin/reseaux/#{p.id}/file"} method="post">
            <button class="btn btn-secondary btn-sm" type="submit" id={"queue-#{p.id}"}>
              En file
            </button>
          </.form>
          <a
            class="btn btn-quiet btn-sm"
            href={~p"/admin/reseaux/#{p.id}/modifier"}
            id={"edit-#{p.id}"}
          >
            Modifier
          </a>
          <.form for={%{}} action={~p"/admin/reseaux/#{p.id}/rejeter"} method="post">
            <button class="btn btn-quiet btn-sm" type="submit" id={"reject-btn-#{p.id}"}>
              Rejeter
            </button>
          </.form>
        </div>
      </article>
    </section>

    <section class="soc-column" id="social-ready" aria-labelledby="col-ready">
      <h2 class="soc-col-head" id="col-ready">
        En file <span class="mono subtle">{length(@board.ready)}</span>
      </h2>
      <p class="small muted">Prêts, sans date · pas encore envoyés à Buffer.</p>
      <p :if={@board.ready == []} class="soc-empty muted">
        File vide. « Ajouter à la file » depuis une page ou un brouillon.
      </p>
      <article :for={p <- @board.ready} class="soc-card" id={"ready-#{p.id}"}>
        <span class="soc-tag">{kind_label(p.kind)}</span>
        <b>{title(p)}</b>
        <span class="soc-nets">
          <.network_mark :for={n <- networks_of(p)} network={n} />
        </span>
        <div class="soc-card-actions">
          <.form for={%{}} action={~p"/admin/reseaux/#{p.id}/valider"} method="post">
            <button
              class="btn btn-primary btn-sm"
              type="submit"
              id={"schedule-#{p.id}"}
              disabled={Enum.any?(networks_of(p), &(&1 in @full))}
            >
              Programmer
            </button>
          </.form>
          <.form for={%{}} action={~p"/admin/reseaux/#{p.id}/maintenant"} method="post">
            <button class="btn btn-secondary btn-sm" type="submit" id={"now-#{p.id}"}>
              Publier maintenant
            </button>
          </.form>
          <a class="btn btn-quiet btn-sm" href={~p"/admin/reseaux/#{p.id}/modifier"}>Modifier</a>
          <.form for={%{}} action={~p"/admin/reseaux/#{p.id}/rejeter"} method="post">
            <button class="btn btn-quiet btn-sm" type="submit" id={"drop-#{p.id}"}>Rejeter</button>
          </.form>
        </div>
      </article>
    </section>

    <section class="soc-column" id="social-scheduled" aria-labelledby="col-scheduled">
      <h2 class="soc-col-head" id="col-scheduled">
        Programmés <span class="mono subtle">{length(@board.scheduled)}</span>
      </h2>
      <p class="small muted">Dans la file Buffer, publiés au créneau.</p>
      <p :if={@board.scheduled == []} class="soc-empty muted">Rien de programmé.</p>
      <article :for={p <- @board.scheduled} class="soc-card" id={"scheduled-#{p.id}"}>
        <span class="soc-tag">{due_label(p) || "envoi en cours"}</span>
        <b>{title(p)}</b>
        <span class="soc-nets">
          <%= for n <- networks_of(p) do %>
            <.network_mark network={n} />
          <% end %>
          <span class={["soc-sync", "is-ok"]}>
            {if Enum.any?(
                  networks_of(p),
                  &(Map.get(p, String.to_existing_atom(&1 <> "_state")) == "pending")
                ),
                do: "envoi vers Buffer…",
                else: "dans Buffer"}
          </span>
        </span>
        <div class="soc-card-actions">
          <.form for={%{}} action={~p"/admin/reseaux/#{p.id}/maintenant"} method="post">
            <button class="btn btn-secondary btn-sm" type="submit" id={"now-#{p.id}"}>
              Publier maintenant
            </button>
          </.form>
          <.form for={%{}} action={~p"/admin/reseaux/#{p.id}/retirer"} method="post">
            <button class="btn btn-quiet btn-sm" type="submit" id={"withdraw-#{p.id}"}>
              Retirer
            </button>
          </.form>
        </div>
      </article>
    </section>

    <section class="soc-column" id="social-published" aria-labelledby="col-published">
      <h2 class="soc-col-head" id="col-published">
        Publiés <span class="mono subtle">{length(@board.published)}</span>
      </h2>
      <p class="small muted">Statistiques Buffer, mises à jour une fois par jour.</p>
      <p :if={@board.published == []} class="soc-empty muted">Rien de publié pour l'instant.</p>
      <article :for={p <- @board.published} class="soc-card" id={"history-#{p.id}"}>
        <span class="soc-tag">{sent_label(p)}</span>
        <b>{title(p)}</b>
        <span class="soc-nets">
          <%= for n <- networks_of(p) do %>
            <.network_mark network={n} />
            <% {label, cls} = network_state(Map.get(p, String.to_existing_atom(n <> "_state"))) %>
            <span :if={label != "Publié"} class={["pill", cls]}>{label}</span>
          <% end %>
        </span>
        <span :if={metrics(p) != []} class="soc-metrics">
          <span :for={{label, value} <- metrics(p)}><b>{value}</b> {label}</span>
        </span>
      </article>
    </section>
  </div>

  <section :if={@board.failed != []} class="card adm-list" id="social-failed">
    <div class="adm-card-head">
      <h2 class="h2">Échecs</h2>
      <span class="mono subtle small">« Renvoyer » relance l'envoi une fois la cause corrigée</span>
    </div>
    <div class="table-wrap">
      <table class="table adm-table">
        <tbody>
          <tr :for={p <- @board.failed} id={"failed-#{p.id}"}>
            <td class="l adm-wrap">{title(p)}</td>
            <%= for {network, name, state, error} <- [
                  {"x", "X", p.x_state, p.x_error},
                  {"linkedin", "LinkedIn", p.linkedin_state, p.linkedin_error}
                ] do %>
              <td class="l">
                <%= case network_state(state) do %>
                  <% nil -> %>
                    <span class="subtle">—</span>
                  <% {label, cls} -> %>
                    <div class="soc-cell">
                      <span class="small">{name}</span>
                      <span class={["pill", cls]}>{label}</span>
                      <button
                        :if={error}
                        type="button"
                        class="soc-alert"
                        popovertarget={"error-#{p.id}-#{network}"}
                        aria-label={"Voir l'erreur d'envoi sur #{name}"}
                        id={"error-btn-#{p.id}-#{network}"}
                      >
                        <svg
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4" /><path d="M12 17.5v.01" />
                        </svg>
                      </button>
                      <.form
                        :if={state in ["queued", "simulated", "failed"]}
                        for={%{}}
                        action={~p"/admin/reseaux/#{p.id}/renvoyer/#{network}"}
                        method="post"
                      >
                        <button
                          class="btn btn-quiet btn-sm"
                          type="submit"
                          id={"resend-#{p.id}-#{network}"}
                          aria-label={"Renvoyer sur #{name}"}
                        >
                          Renvoyer
                        </button>
                      </.form>
                    </div>
                    <div
                      :if={error}
                      popover
                      id={"error-#{p.id}-#{network}"}
                      class="soc-pop"
                      role="dialog"
                      aria-label={"Erreur d'envoi sur #{name}"}
                    >
                      <h3 class="h3">Erreur d'envoi sur {name}</h3>
                      <p class="small">{error}</p>
                      <p class="small muted">
                        « Renvoyer » relance l'envoi sur ce réseau une fois la cause corrigée.
                      </p>
                      <button
                        type="button"
                        class="btn btn-secondary btn-sm"
                        popovertarget={"error-#{p.id}-#{network}"}
                        popovertargetaction="hide"
                      >
                        Fermer
                      </button>
                    </div>
                <% end %>
              </td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section :if={@candidates != []} class="card adm-list" id="social-candidates">
    <div class="adm-card-head">
      <div>
        <h2 class="h2">Décisions récentes sans post</h2>
        <p class="small muted">
          Changements de note ou de perspective des 60 derniers jours, arrivés avant les posts ou vérifiés à la main.
        </p>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table adm-table">
        <tbody>
          <tr :for={r <- @candidates} id={"candidate-#{r.id}"}>
            <td class="l">{area_name(r.country_code)} · {agency_name(r.agency)}</td>
            <td class="l num">
              {r.rating}{if r.outlook not in [nil, "none"], do: ", #{r.outlook}"}
            </td>
            <td class="subtle">{r.action_date}</td>
            <td>
              <.form for={%{}} action={~p"/admin/reseaux/preparer/notation/#{r.id}"} method="post">
                <button class="btn btn-secondary btn-sm" type="submit" id={"prepare-#{r.id}"}>
                  Préparer le post
                </button>
              </.form>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</.admin_shell>
