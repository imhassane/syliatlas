<Layouts.public ticker={false} locale={@locale} current={:recap}>
  <section class="section section-alt">
    <div class="wrap recap-page">
      <div class="stack gap-3 recap-intro">
        <p class="eyebrow">{gettext("The recap")}</p>
        <h1 class="h1">{gettext("Your countries, every Monday, in your inbox")}</h1>
        <p class="lead muted">
          {gettext(
            "For each country you choose: the rating decisions, the stock exchange and the currency of the week, and the IMF landmarks. Free, without an account."
          )}
        </p>
      </div>
      <form
        method="post"
        action={Paths.recap(@locale)}
        class="card pad stack gap-4"
        id="recap-form"
      >
        <p :if={@error} class="adm-flash err" role="alert" id="recap-error">{@error}</p>
        <label class="field">
          <span class="eyebrow">{gettext("Email address")}</span>
          <input
            class="input"
            type="email"
            name="email"
            id="recap-email"
            autocomplete="email"
            value={@email}
            required
          />
        </label>
        <.country_picker regions={@regions} picked={@picked} max={@max} />
        <.frequency_picker frequency={@frequency} />
        <div class="stack gap-2">
          <button class="btn btn-primary btn-lg" type="submit" id="recap-submit">
            {gettext("Get the recap")} →
          </button>
          <p class="small muted">
            {gettext(
              "We send one email to confirm the address: nothing goes out before you click its link. One click in each recap to stop it."
            )}
          </p>
          <details class="small muted" id="recap-privacy">
            <summary>{gettext("What we keep")}</summary>
            <p>
              {gettext(
                "Your address, your countries, the frequency and the language, nothing else: no name, no IP address, no tracking of opens or clicks. Stopping the recap deletes the address; an address never confirmed is deleted after 7 days. The emails go out through Resend."
              )}
            </p>
          </details>
        </div>
      </form>
    </div>
  </section>
</Layouts.public>
