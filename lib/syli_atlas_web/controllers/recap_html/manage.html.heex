<Layouts.public ticker={false} locale={@locale} current={:recap}>
  <section class="recap-hero recap-hero-small">
    <div class="recap-hero-band" aria-hidden="true"></div>
    <div class="wrap recap-hero-text">
      <p class="eyebrow">{gettext("The Monday recap")}</p>
      <h1 class="h1">{gettext("Change my recap")}</h1>
      <p class="muted">{gettext("Sent to")} <b dir="ltr">{@email}</b>.</p>
    </div>
  </section>
  <section class="recap-body">
    <form
      method="post"
      action={"/recap/manage/" <> @token}
      class="wrap recap-form"
      id="recap-manage-form"
      data-recap-page
    >
      <p :if={@saved} class="adm-flash ok" role="status" id="recap-saved">{gettext("Saved.")}</p>
      <p :if={@error} class="adm-flash err" role="alert" id="recap-error">{@error}</p>
      <.country_picker regions={@regions} picked={@picked} max={@max} />
      <.frequency_picker frequency={@frequency} />
      <.summary_bar names={picked_names(@regions, @picked)} frequency={@frequency} max={@max}>
        <a class="btn btn-quiet" href={"/recap/stop/" <> @token} id="recap-stop-link">
          {gettext("Stop the recap")}
        </a>
        <button class="btn btn-primary btn-lg" type="submit">{gettext("Save")}</button>
      </.summary_bar>
    </form>
  </section>
</Layouts.public>
