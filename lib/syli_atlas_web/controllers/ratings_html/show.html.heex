<Layouts.public locale={@locale} current={:ratings} alternates={@alternates}>
  <div class="wrap">
    <nav aria-label={gettext("Breadcrumb")}>
      <ol class="crumbs rt-crumbs">
        <li><a href={Paths.home(@locale)}>Syli Atlas</a></li>
        <li><a href={Paths.ratings(@locale)}>{gettext("Sovereign ratings")}</a></li>
        <li aria-current="page">{@name}</li>
      </ol>
    </nav>
  </div>

  <.rating_section entry={@entry} name={@name} rated={@doc["rated"]} locale={@locale} page />

  <.section :if={@entry["band"]} id="rating-context">
    <div class="grid grid-2">
      <.card pad class="stack gap-2">
        <p class="eyebrow">{gettext("Follow")}</p>
        <SyliAtlasWeb.AccountComponents.follow
          kind="area"
          ref={@entry["code"]}
          locale={@locale}
          path={Paths.rating(@locale, SyliAtlas.Locales.pick(@entry["slug"], @locale))}
          alert_area={@entry["code"]}
        />
        <p class="small muted">
          {gettext(
            "An email at the next decision of an agency on %{name}.",
            SyliAtlasWeb.Format.names(@name)
          )}
        </p>
        <div :if={@context} class="stack gap-1" id="rating-figures">
          <h2 class="h3">{gettext("The figures behind the rating")}</h2>
          <p>
            <span :if={is_number(@context.debt)}>
              {gettext("Public debt %{year}", year: @context.year)}:
              <b class="num">{SyliAtlasWeb.Format.number(@context.debt, 0, @locale)} %</b>
              {gettext("of GDP")} ·
            </span>
            <span :if={is_number(@context.growth)}>
              {gettext("Real growth %{year}", year: @context.year)}:
              <b class="num">{SyliAtlasWeb.Format.number(@context.growth, 1, @locale)} %</b>
            </span>
          </p>
          <p class="small muted">{gettext("IMF, World Economic Outlook")}</p>
        </div>
      </.card>
      <.card :if={@same_band != []} pad class="stack gap-2" id="rating-same-band">
        <p class="eyebrow">{gettext("In the same band")}</p>
        <h2 class="h3">{SyliAtlasWeb.RatingComponents.verdict(@entry["band"])}</h2>
        <ul class="stack gap-1" role="list">
          <li :for={c <- @same_band}>
            <a href={Paths.rating(@locale, c.slug)}>{c.name}</a>
            <span class="num muted small">{c.label}</span>
          </li>
        </ul>
      </.card>
    </div>
    <nav class="chips" aria-label={gettext("See also")} id="rating-see-also">
      <a class="chip" href={Paths.ratings(@locale)}>{gettext("All African ratings")}</a>
      <a
        class="chip"
        href={Paths.area(@locale, "country", SyliAtlas.Locales.pick(@entry["slug"], @locale))}
      >
        {gettext("Profile of %{name}", name: @name)}
      </a>
      <a class="chip" href={Paths.debt(@locale)}>{gettext("Public debt in Africa")}</a>
      <a
        :for={c <- @communities}
        class="chip"
        href={Paths.community(@locale, SyliAtlas.Locales.pick(c.slug, @locale) || c.slug["en"])}
      >
        {SyliAtlas.Locales.pick(c.short, @locale) || c.short["en"]}
      </a>
    </nav>
  </.section>

  <.section :if={@history != []} id="rating-history" variant="alt">
    <.section_head
      eyebrow={gettext("History")}
      title={gettext("Decisions of the agencies for %{name}", name: @name)}
      size="h2"
    />
    <div class="card table-box">
      <table class="table table-stack" id="rating-history-rows">
        <caption class="vh">
          {gettext("Decisions of the agencies for %{name}", name: @name)}
        </caption>
        <thead>
          <tr>
            <th scope="col" class="l">{gettext("Date")}</th>
            <th scope="col" class="l">{gettext("Agency")}</th>
            <th scope="col" class="l">{gettext("Decision")}</th>
            <th scope="col" class="l">{gettext("Rating")}</th>
            <th scope="col" class="l">{gettext("Outlook")}</th>
            <th scope="col" class="l">{gettext("Source")}</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={r <- @history}>
            <td class="l num" data-label={gettext("Date")}>
              {date_text(r.action_date, @locale) || "—"}
            </td>
            <td class="l" data-label={gettext("Agency")}>{agency_name(r.agency)}</td>
            <td class="l" data-label={gettext("Decision")}>{action_label(r.action_type)}</td>
            <td class="l" data-label={gettext("Rating")}>
              <b class="num">{Scale.display(r.rating)}</b><span
                :if={r.needs_check}
                title={gettext("To check")}
              >*</span>
            </td>
            <td class="l" data-label={gettext("Outlook")}>{outlook_label(r.outlook)}</td>
            <td class="l" data-label={gettext("Source")}>
              <a :if={r.source_url} href={r.source_url} rel="nofollow noopener">
                {source_host(r.source_url)} ↗
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </.section>

  <.section :if={@faq != []} id="rating-faq">
    <div class="stack gap-3">
      <h2 class="h2">{gettext("Questions")}</h2>
      <.faq items={@faq} />
    </div>
  </.section>
</Layouts.public>
